# App URL (no trailing slash). Used by auth redirects and Stripe return URLs.
# Astro dev default: http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321

# Supabase: Project Settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables deeper intake advisor analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Weekly job search (Rethink step 3). Needs OPENAI_API_KEY above.
# Use a reasoning model. Non-reasoning models (e.g. gpt-4.1-mini) fabricated postings in testing.
JOB_SEARCH_MODEL=gpt-5.4
# Per-run spend ceiling in USD. Enforced only once JOB_SEARCH_PRICING_JSON is set; until then runs
# are bounded by token and search-call caps and cost is reported as "not estimated".
JOB_SEARCH_MAX_RUN_COST_USD=1
# Copy current prices from OpenAI's pricing page; the app never hardcodes them. Example shape:
# JOB_SEARCH_PRICING_JSON={"inputPerMillionTokensUsd":0,"outputPerMillionTokensUsd":0,"perWebSearchCallUsd":0}
JOB_SEARCH_PRICING_JSON=

# Optional: production geocoding for employer geography search.
# If set, CIP uses Geocodio first and falls back to Nominatim/OpenStreetMap when unavailable.
GEOCODIO_API_KEY=

# Optional: identify this app for fallback Nominatim/OpenStreetMap geocoding.
# Example: CIP-Career-Assistant/0.1 (email@example.com)
GEOCODER_USER_AGENT=

# Optional: Stripe webhook signing secret. Required for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Optional: service role. Webhook records payments and bypasses RLS. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: API keys (never expose sk_ to the client)
STRIPE_SECRET_KEY=

# Stripe: Product > Price ID (price_...)
STRIPE_PRICE_ID=

# Optional: pk_ for future Stripe.js / Payment Element
PUBLIC_STRIPE_PUBLISHABLE_KEY=
