---
import Layout from "../layouts/Layout.astro";
import { createServer } from "../lib/supabase/server";
let signedIn = false;
if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const { data: { user } } = await createServer(Astro.cookies).auth.getUser();
    signedIn = Boolean(user);
    if (user && Astro.url.searchParams.get("intro") !== "1") return Astro.redirect("/workbench");
  } catch { /* The public introduction stays available if auth is unavailable. */ }
}
const startHref = signedIn ? "/intake" : "/login";
const activities = [
  { icon: "user-circle", title: "Bring your experience", body: "Start with your resume, goals, and what matters to you. Include the work you are proud of, the constraints you face, and the questions you are still figuring out." },
  { icon: "compass", title: "Explore credible directions", body: "Connect transferable strengths to possible career paths. Targeted questions help uncover the experience behind your story, while evidence and gaps stay visible." },
  { icon: "magnifying-glass", title: "Test those directions", body: "Research employers, review job listings, have conversations, or try a bounded career experiment. Choose a next step that helps you learn something useful." },
  { icon: "arrows-clockwise", title: "Bring back what you learn", body: "Save your findings, update your strategy when you are ready, and review what changed. Keep useful alternatives as your priorities evolve." },
];
---
<Layout publicPage title="CIP — Career directions that fit you" description="Connect your experience to career directions that fit you. Test them, learn what works, and refine your plan as you go.">
<main class="landing">
  <section class="landing-hero">
    <div class="landing-hero-copy"><p class="landing-eyebrow">Career intelligence, built around you</p><h1>Your experience has a story.<br/><span>Find the directions that fit you.</span></h1><p class="landing-lead">Connect your experience to career directions that fit you. Test them, learn what works, and refine your plan as you go.</p><div class="landing-actions"><a class="landing-primary" href={startHref}>Start with your experience<i class="ph ph-arrow-right" aria-hidden="true"></i></a><a class="landing-text-link" href="#how-it-works">See how CIP works</a></div><p class="landing-note">{signedIn ? "Your saved direction is ready whenever you want to revisit it." : "Sign in to save your experience and return to your work."}</p></div>
    <figure class="landing-preview"><a href="#workbench-preview" aria-label="Learn about the Workbench preview"><img src="/images/workbench-design-preview.webp" width="1486" height="1058" alt="Illustrative CIP Workbench design with three career directions, a research task, and a separate strategy-update action." fetchpriority="high"/></a><figcaption>Workbench design preview · illustrative content, not a user's records.</figcaption></figure>
  </section>
  <section class="landing-story"><p class="landing-eyebrow">A varied career can be a strength</p><h2>You have done more than a job title can explain.</h2><p>Changing roles, industries, or priorities does not erase what you know. CIP helps you connect the threads of your experience, explain the value you bring, and decide where to put your next effort.</p><p class="landing-story-close">A clearer story. Credible possibilities. A practical next move.</p></section>
  <section class="landing-loop" id="how-it-works"><div class="landing-section-heading"><div><p class="landing-eyebrow">How CIP works</p><h2>A direction to explore.<br/>A plan that keeps learning.</h2></div><p>Start by understanding your experience. Then return as you learn from the world around you. You do not have to repeat onboarding every time something changes.</p></div><div class="landing-activities">{activities.map((item, index) => <article><div class="landing-activity-label"><i class={`ph ph-${item.icon}`} aria-hidden="true"></i><span>{String(index+1).padStart(2,"0")}</span></div><h3>{item.title}</h3><p>{item.body}</p></article>)}</div><p class="landing-loop-note"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>These activities form a repeating loop. There is no final career answer you have to settle for.</p></section>
  <section class="landing-workbench" id="workbench-preview"><div><p class="landing-eyebrow">Your place to do the work</p><h2>Turn a possibility into a next step.</h2><p>The Workbench brings your directions, actions, and new learning together. Pick something worth investigating, record what happens, and decide what it means for your plan.</p><ul><li><i class="ph ph-compass" aria-hidden="true"></i><span><strong>Keep alternatives in view.</strong> A new priority does not erase your other career directions.</span></li><li><i class="ph ph-note-pencil" aria-hidden="true"></i><span><strong>Capture useful findings.</strong> Save research, conversations, goal changes, and corrections in the tools designed for them.</span></li><li><i class="ph ph-arrows-clockwise" aria-hidden="true"></i><span><strong>Update deliberately.</strong> Saving information and incorporating it into strategy are separate steps.</span></li></ul><a class="landing-text-link" href={signedIn ? "/workbench" : "/login"}>{signedIn ? "Open your Workbench" : "Sign in to start your Workbench"}<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><aside><p class="landing-eyebrow">A useful career question</p><blockquote>“What would I need to learn before investing more time in this direction?”</blockquote><p>A conversation, an employer investigation, or a small experiment can move you forward—even when the answer is “not enough information yet.”</p><p class="landing-note">CIP supports decisions. It does not guarantee a job or a business outcome.</p></aside></section>
  <section class="landing-trust"><div><p class="landing-eyebrow">Use job boards. Bring a better question.</p><h2>Put your effort where it belongs.</h2><p>CIP works alongside your job search. Review discovered listings, research employers, and compare possibilities with your goals and evidence. A listing being open and a role being right for you are different questions.</p><p>See what was checked and when, distinguish an AI interpretation from evidence, and correct the picture when it misses something. New learning should improve the plan.</p></div><div class="landing-principles"><article><h3>Your experience comes first</h3><p>Targeted evidence and questions help you tell your story beyond a generic job-title match.</p></article><article><h3>Uncertainty stays visible</h3><p>A source check is not a promise of hiring intent. An unanswered question is a reason to investigate, not a judgment about your ability.</p></article><article><h3>Your goals can change</h3><p>Explore a new role, a different field, or an entrepreneurial direction while keeping your constraints and alternatives in view.</p></article></div></section>
  <section class="landing-faq"><p class="landing-eyebrow">Before you begin</p><h2>A few things worth knowing.</h2><details><summary>Do I need to know what job I want?</summary><p>No. Bring your experience and the questions you have. CIP helps you develop directions to investigate; you can refine them as you learn.</p></details><details><summary>Is this a one-time career test?</summary><p>No. Your saved experience is a starting point. Evidence questions, conversations, employer research, and changes in your goals can inform later strategy updates.</p></details><details><summary>Does CIP replace job boards or personal conversations?</summary><p>No. It helps you decide which possibilities deserve attention and prepare better questions. Job boards and people in your network remain useful sources of information.</p></details><details><summary>What happens when I start?</summary><p>You sign in, capture your story and constraints, deepen the evidence, and review possible career lanes. Then choose a next action in Workbench. Returning users can continue their saved work.</p></details></section>
  <section class="landing-close"><p class="landing-eyebrow">Your next chapter starts with what you already bring</p><h2>Find a direction worth testing.</h2><p>You do not need the whole answer to take a useful next step.</p><a class="landing-primary" href={startHref}>Start with your experience<i class="ph ph-arrow-right" aria-hidden="true"></i></a><a class="landing-text-link" href="/workbench">Already started? Open your Workbench</a></section>
</main>
<footer class="landing-footer"><a href="/?intro=1" class="public-brand"><strong>CIP</strong><span>Career Intelligence Platform</span></a><p>Your experience. Your direction. Your next move.</p><nav aria-label="Footer navigation"><a href="#how-it-works">How CIP works</a><a href="/contact">Contact</a><a href={signedIn ? "/workbench" : "/login"}>{signedIn ? "Workbench" : "Sign in"}</a></nav></footer>
</Layout>
