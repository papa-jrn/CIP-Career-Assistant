---
import { renderFitClarification } from "@/lib/cip/fit-action-view";
import { renderFitAssessment } from "@/lib/cip/fit-assessment-view";
import { loadArchiveContext, isImportedArchived } from "../lib/cip/job-archive";
import Layout from "../layouts/Layout.astro";
import { loadJobSearchConfig } from "../lib/cip/job-search-config";
import { loadDueState, loadLatestRunView } from "../lib/cip/job-search-run";
import { buildPostingAnnotations } from "../lib/cip/opportunity-recommendations";
import { renderJobSearchPanel } from "../lib/cip/job-search-view";
import { loadStoredSearchPreferences, type StoredSearchPreferences } from "../lib/cip/search-preferences";
import { readJobSearchEnv } from "../lib/cip/server-env";
import {
  IMPORTED_JOB_CHECK_SOURCE_TYPE,
  applyLatestCheck,
  checksForJob,
  employerResearchForJob,
  describeCheckAge,
  describeCheckChange,
  isCheckStale,
  parseImportedJobCheck,
  readableState,
  type ImportedJobCheck,
} from "../lib/cip/imported-job-checks";
import {
  IMPORTED_JOB_FIT_SOURCE_TYPE,
  latestCurrentFitFor,
  parseImportedJobFit,
  readableRecommendation,
  type FitAssessment,
} from "../lib/cip/imported-job-fit";
import {
  IMPORTED_JOB_SOURCE_TYPE,
  describeFit,
  describeProvenance,
  latestImportedJobs,
  parseImportedJob,
  type ImportedJob,
} from "../lib/cip/imported-jobs";
import { createServer } from "../lib/supabase/server";

type SavedEmployer = {
  id: string;
  name: string;
  region: string;
  priority: string;
  careers_url: string | null;
};

const showingArchived = Astro.url.searchParams.get("jobs") === "archived";
let archivedImports: ImportedJob[] = [];
let activeImports: ImportedJob[] = [];
let signedIn = false;
let loadError = "";
let panelHtml = "";
let employers: SavedEmployer[] = [];
let preferences: StoredSearchPreferences | null = null;
let preferencesError = "";
// Jobs the user brought in themselves, newest first.
let importedJobs: ImportedJob[] = [];
// Every listing check, kept so a posting that changed can say so.
let importedJobChecks: ImportedJobCheck[] = [];
// Fit assessments, including the user's own corrections of them.
let importedJobFits: FitAssessment[] = [];
const fitForJob = (job: ImportedJob) => latestCurrentFitFor(job, importedJobFits);

if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const supabase = createServer(Astro.cookies);
    const {
      data: { user },
    } = await supabase.auth.getUser();
    signedIn = Boolean(user);

    if (user) {
      const [employerResult, storedPreferences] = await Promise.all([
        supabase
          .from("watched_employers")
          .select("id,name,region,priority,careers_url")
          .eq("user_id", user.id)
          .order("fit_score", { ascending: false })
          .limit(100),
        loadStoredSearchPreferences(supabase, user.id).catch((error: Error) => error),
      ]);

      const { data: importedRows } = await supabase
        .from("career_sources")
        .select("extracted_text, created_at")
        .eq("user_id", user.id)
        .eq("source_type", IMPORTED_JOB_SOURCE_TYPE)
        .order("created_at", { ascending: false })
        .limit(50);
      const { data: checkRows } = await supabase
        .from("career_sources")
        .select("extracted_text, created_at")
        .eq("user_id", user.id)
        .eq("source_type", IMPORTED_JOB_CHECK_SOURCE_TYPE)
        .order("created_at", { ascending: false })
        .limit(300);
      importedJobChecks = (checkRows ?? [])
        .map((row) => parseImportedJobCheck(row.extracted_text, row.created_at))
        .filter(Boolean) as ImportedJobCheck[];

      const { data: fitRows } = await supabase
        .from("career_sources")
        .select("extracted_text, created_at")
        .eq("user_id", user.id)
        .eq("source_type", IMPORTED_JOB_FIT_SOURCE_TYPE)
        .order("created_at", { ascending: false })
        .limit(300);
      importedJobFits = (fitRows ?? [])
        .map((row) => parseImportedJobFit(row.extracted_text, row.created_at))
        .filter(Boolean) as FitAssessment[];

      importedJobs = latestImportedJobs(((importedRows ?? [])
        .map((row) => parseImportedJob(row.extracted_text))
        .filter(Boolean) as ImportedJob[]))
        // The stored capture is never edited; the latest check is layered on
        // at read time so the original stays intact.
        .map((job) => applyLatestCheck(job, importedJobChecks));

      const archive = await loadArchiveContext(supabase, user.id);
      archivedImports = importedJobs.filter(job => isImportedArchived(job, importedJobFits, archive.dispositions, archive.events));
      activeImports = importedJobs.filter(job => !archivedImports.includes(job));
      importedJobs = showingArchived ? archivedImports : activeImports;

      if (employerResult.error) loadError = employerResult.error.message;
      else employers = (employerResult.data ?? []) as SavedEmployer[];
      if (storedPreferences instanceof Error) preferencesError = storedPreferences.message;
      else preferences = storedPreferences;

      // The weekly search panel: latest run, due state, and whether the provider is configured.
      try {
        const config = loadJobSearchConfig(readJobSearchEnv);
        const latestRun = await loadLatestRunView(supabase, user.id);
        const due = await loadDueState(supabase, user.id, config, new Date().toISOString());
        const annotations = latestRun ? await buildPostingAnnotations(supabase, user.id, latestRun) : undefined;
        panelHtml = renderJobSearchPanel(latestRun, { runKey: crypto.randomUUID(), due, configured: config.configured }, annotations);
      } catch (error) {
        const detail = error instanceof Error ? error.message : "unknown error";
        panelHtml = `<div id="job-search-panel"><p class="text-sm text-red-800">Could not load the weekly job search: ${detail.replace(/[<>&]/g, "")}. If this mentions a missing table, apply the latest Supabase migrations.</p></div>`;
      }
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Unable to load opportunities.";
  }
}

const workModeLabel: Record<string, string> = { onsite: "On-site", hybrid: "Hybrid", remote: "Remote" };
const withCareerPage = employers.filter((employer) => employer.careers_url);
---

<Layout title="CIP Opportunities">
  <main class="cip-page-shell mx-auto w-full max-w-5xl px-5 py-8">
    <section class="cip-card rounded-lg p-6">
      <p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Opportunities</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Verified openings, checked on their own pages.</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">
        Once a week, the search reads your target employers' career pages, then the job sites you trust, then the open web.
        Every posting is opened on its own page and checked before it is called open. Nothing here is a bare match score.
        Roles that are far away, past their deadline, or on your exclusion list are kept and shown separately, not hidden.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="cip-fancy-button" href="#imported-jobs" data-open-import><span>Bring a job you found</span></a>
        <a class="cip-fancy-button cip-fancy-button-secondary" href="/preferences"><span>Search preferences</span></a>
        <a class="cip-fancy-button cip-fancy-button-secondary" href="/employers"><span>Employers</span></a>
      </div>

      {!signedIn ? (
        <p class="mt-6 rounded-md border border-[var(--line)] bg-[var(--background)] p-4 text-sm">
          <a class="font-semibold underline" href="/login">Sign in</a> to run and review your weekly search.
        </p>
      ) : null}
      {loadError ? <p class="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">{loadError}</p> : null}

      {signedIn && panelHtml ? (
        <div class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5">
          <Fragment set:html={panelHtml} />
        </div>
      ) : null}
    </section>

    {signedIn ? (
      <section class="cip-card mt-6 rounded-lg p-6">
        <h2 class="text-lg font-semibold">What this search covers</h2>
        <p class="mt-1 text-sm text-[var(--muted)]">Change any of this on Search preferences. Anything unset is treated as unknown, never as "no limit."</p>
        {preferencesError ? <p class="mt-3 text-sm text-red-800">Could not load your preferences: {preferencesError}</p> : null}
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Places</h3>
            {preferences && preferences.anchorRequests.length ? (
              <ul class="mt-2 grid gap-1 text-sm">
                {preferences.anchorRequests.map((place) => <li>{place.label} <span class="text-[var(--muted)]">within {place.radiusMiles} mi</span></li>)}
              </ul>
            ) : (
              <p class="mt-2 text-sm text-[var(--muted)]">None saved. Add at least one place, or accept remote work, so the local search has somewhere to look.</p>
            )}
            {preferences && preferences.workModes.length ? (
              <p class="mt-3 text-xs text-[var(--muted)]">Accepted: {preferences.workModes.map((mode) => workModeLabel[mode] ?? mode).join(", ")}</p>
            ) : null}
            {preferences?.salaryFloorUsd ? (
              <p class="mt-1 text-xs text-[var(--muted)]">Minimum salary: ${preferences.salaryFloorUsd.toLocaleString("en-US")} a year</p>
            ) : null}
          </div>
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Job sites you trust</h3>
            {preferences && preferences.preferredSources.length ? (
              <ul class="mt-2 grid gap-1 text-sm">
                {preferences.preferredSources.map((site) => <li>{site}</li>)}
              </ul>
            ) : (
              <p class="mt-2 text-sm text-[var(--muted)]">None yet. The search still checks employer pages and the open web.</p>
            )}
            <p class="mt-3 text-xs text-[var(--muted)]">Sites that require a login (LinkedIn, Indeed) cannot be searched.</p>
          </div>
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Target employers</h3>
            <p class="mt-2 text-sm">{employers.length} saved <span class="text-[var(--muted)]">({withCareerPage.length} with a career page on file)</span></p>
            <p class="mt-3 text-xs text-[var(--muted)]">The search opens their career pages first. It finds a page itself when none is on file.</p>
          </div>
        </div>

        {employers.length ? (
          <details class="mt-5 rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
            <summary class="cursor-pointer text-sm font-semibold">Saved employers ({employers.length})</summary>
            <ul class="mt-3 grid gap-2 text-sm">
              {employers.map((employer) => (
                <li class="flex flex-wrap items-baseline justify-between gap-2">
                  <span><span class="font-semibold">{employer.name}</span> <span class="text-[var(--muted)]">{employer.region.replaceAll("_", " ")}</span></span>
                  {employer.careers_url ? (
                    <a class="text-xs underline" href={employer.careers_url} target="_blank" rel="noopener noreferrer">Career page</a>
                  ) : (
                    <span class="text-xs text-[var(--muted)]">No career page on file</span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ) : null}
      </section>
    ) : null}

    <section id="imported-jobs" class="cip-card mt-6 rounded-lg p-6">
      <p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Bring a job you found</p>
      <h2 class="mt-2 text-2xl font-semibold">A job from anywhere else.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">
        Paste a link, the text of the posting, or both. CIP keeps exactly what you supply, with the time
        you captured it. Saving a job does not check the listing, judge whether it suits you, start
        watching the employer, or contact anyone - those stay separate and deliberate.
      </p>

      {Astro.url.searchParams.get("assessed") ? (
        <p data-announce tabindex="-1" role="status" class="mt-4 rounded-md border border-[var(--line)] bg-[var(--background)] p-3 text-sm">
          {Astro.url.searchParams.get("assessed") === "user"
            ? "Your conclusion is saved. CIP's earlier reading is kept beside it."
            : "Fit assessed from what you saved and what you have told CIP you want. Whether the listing is real is a separate question."}
        </p>
      ) : null}
      {Astro.url.searchParams.get("checked") === "1" ? (
        <p data-announce tabindex="-1" role="status" class="mt-4 rounded-md border border-[var(--line)] bg-[var(--background)] p-3 text-sm">
          Listing checked. The result is on the job below, with what it does and does not establish.
        </p>
      ) : null}
      {Astro.url.searchParams.get("imported") === "1" ? (
        <p data-announce tabindex="-1" role="status" class="mt-4 rounded-md border border-[var(--line)] bg-[var(--background)] p-3 text-sm">
          Job saved with the material you supplied. It has not been checked or assessed yet.
        </p>
      ) : null}

      {signedIn ? (
        <details
          id="bring-a-job"
          class="mt-5 rounded-md border border-[var(--line)] bg-[var(--background)] p-4"
          open={Astro.url.searchParams.get("bring") === "1" || Astro.url.searchParams.get("imported") === "1"}
        >
          <summary class="cursor-pointer text-sm font-semibold text-[var(--accent-strong)]">
            Add a job you found
          </summary>
        <form
          class="mt-4 grid gap-3"
          method="post"
          action="/api/jobs/import"
          hx-post="/api/jobs/import"
          hx-target="#import-job-result"
          hx-swap="innerHTML"
        >
          <div class="grid gap-3 md:grid-cols-2">
            <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
              Job title
              <input name="title" required maxlength="200" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
            </label>
            <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
              Employer
              <input name="employer" required maxlength="200" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
            </label>
          </div>
          <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
            First source link (optional if you paste the text)
            <input name="sourceUrl" type="url" maxlength="2000" placeholder="Employer career page or LinkedIn link" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
          </label>
          <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
            Text from the first source (optional)
            <textarea name="originalMaterial" rows="6" maxlength="40000" placeholder="Paste the posting as you found it. It is kept as your own material, not treated as a verified listing." class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal leading-6 text-[var(--foreground)]"></textarea>
          </label>
          <details class="mt-3 rounded-md border border-[var(--field-border)] p-3">
            <summary class="cursor-pointer text-sm font-semibold">Add another source and its version of the posting</summary>
            <label class="mt-3 grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Second source link<input name="secondarySourceUrl" type="url" maxlength="2000" placeholder="A LinkedIn, employer, or other link" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" /></label>
            <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Text from the second source<textarea name="secondaryMaterial" rows="5" maxlength="40000" placeholder="Paste this site's version separately so CIP can see the differences." class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal leading-6 text-[var(--foreground)]"></textarea></label>
          </details>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
              Requisition or job ID (optional)
              <input name="requisitionId" maxlength="80" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
            </label>
            <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
              Location as stated (optional)
              <input name="worksiteText" maxlength="200" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
            </label>
          </div>
          <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">
            Why you saved it (optional)
            <input name="userNote" maxlength="1000" placeholder="What made this worth a look?" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <button class="cip-action cip-action-primary" type="submit">Save this job</button>
            <label class="flex items-center gap-2 text-xs text-[var(--muted)]">
              <input type="checkbox" name="confirmDuplicate" value="yes" class="h-4 w-4" />
              Add it anyway if it looks like one I already have
            </label>
          </div>
          <div id="import-job-result" class="text-sm" aria-live="polite"></div>
        </form>
        </details>
      ) : (
        <p class="mt-5 rounded-md border border-[var(--line)] bg-[var(--background)] p-4 text-sm">
          <a class="font-semibold underline" href="/login">Sign in</a> to bring in a job you found.
        </p>
      )}

      <nav class="mt-6 flex flex-wrap gap-4" aria-label="Imported job views"><a class="underline" aria-current={!showingArchived ? "page" : undefined} href="/opportunities?jobs=active#imported-jobs">Active jobs ({activeImports.length})</a><a class="underline" aria-current={showingArchived ? "page" : undefined} href="/opportunities?jobs=archived#imported-jobs">Archived jobs ({archivedImports.length})</a></nav>
      {!importedJobs.length && <p class="mt-3 text-sm">{showingArchived ? "No archived imported jobs." : "No active imported jobs. Archived jobs remain available above."}</p>}
      {importedJobs.length ? (
        <div class="mt-8">
          <h3 class="text-sm font-semibold uppercase text-[var(--muted)]">
            {importedJobs.length === 1 ? "1 job you brought in" : importedJobs.length + " jobs you brought in"}
          </h3>
          <div class="mt-3 grid gap-3">
            {[{ label: "Jobs to review", jobs: importedJobs.filter(job => showingArchived || fitForJob(job)?.analysis?.rubricVersion !== 3 || fitForJob(job)?.analysis?.score == null || fitForJob(job)!.analysis!.score! >= 6), lower: false }, { label: "Lower-fit opportunities", jobs: showingArchived ? [] : importedJobs.filter(job => fitForJob(job)?.analysis?.rubricVersion === 3 && fitForJob(job)?.analysis?.score != null && fitForJob(job)!.analysis!.score! < 6), lower: true }].filter(group => group.jobs.length).map(group => <details open={!group.lower} class="rounded-md border border-[var(--line)] p-3"><summary class="cursor-pointer font-semibold">{group.label} ({group.jobs.length})</summary>{group.lower && <p class="mt-2 text-xs">Scored below 6. Kept for review; Not for me archives a job.</p>}<div class="mt-3 grid gap-3">{group.jobs.map((job) => (
              <article class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-[var(--foreground)]">{job.title}</p>
                    <p class="mt-1 text-sm text-[var(--muted)]">
                      {job.worksiteText ? job.employer + " \u00b7 " + job.worksiteText : job.employer}
                    </p>
                  </div>
                  <span class="rounded-md border border-[var(--line)] bg-[var(--panel)] px-2 py-1 text-xs font-semibold text-[var(--muted)]">
                    {job.material === "pasted" ? "Your pasted text" : job.material === "url" ? "Your link" : "Link and text"}
                  </span>
                </div>
                {job.userNote ? (
                  <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{job.userNote}</p>
                ) : null}
                {job.sourceLinks?.length ? <div class="mt-3 flex flex-wrap gap-2">{job.sourceLinks.map((source) => <a class="cip-action" href={source.url} target="_blank" rel="noreferrer noopener">Open {source.label}</a>)}</div> : null}
                {job.originalMaterial || job.sourceLinks?.some((source) => source.material) ? <details class="mt-3 rounded-md border border-[var(--line)] p-3"><summary class="cursor-pointer text-sm font-semibold">View captured text from each source</summary>{(job.sourceLinks?.length ? job.sourceLinks : [{ label: "Pasted text", url: "", material: job.originalMaterial }]).filter((source) => source.material).map((source) => <section class="mt-3"><h4 class="text-xs font-semibold uppercase text-[var(--muted)]">{source.label}</h4><p class="mt-1 break-words whitespace-pre-wrap text-sm leading-6 text-[var(--foreground)]">{source.material}</p>{source.url ? <a class="text-xs" href={source.url} target="_blank" rel="noreferrer noopener">Open this source</a> : null}</section>)}</details> : null}
                <dl class="mt-3 grid gap-2 text-sm leading-6 md:grid-cols-2">
                  <div class="rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
                    <dt class="text-xs font-semibold uppercase text-[var(--muted)]">Is the listing real and live?</dt>
                    <dd class="mt-1 text-[var(--muted)]">{describeProvenance(job)}</dd>
                    <dd class="mt-2 text-xs text-[var(--muted)]">{describeCheckAge(job)}</dd>
                    {describeCheckChange(job.importId, importedJobChecks) ? (
                      <dd class="mt-2 rounded-md border border-[var(--line)] bg-[var(--background)] p-2 text-xs text-[var(--foreground)]">
                        {describeCheckChange(job.importId, importedJobChecks)}
                      </dd>
                    ) : null}
                  </div>
                  <div class="rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
                    <dt class="text-xs font-semibold uppercase text-[var(--muted)]">Does it suit you?</dt>
                    <dd id={`fit-assessment-${job.importId}`} tabindex="-1" class="mt-2 scroll-mt-6 rounded-md border border-[var(--line)] p-3" role="region" aria-label="Fit assessment" set:html={fitForJob(job) ? renderFitAssessment(fitForJob(job)!, true) : "<p>Fit not assessed yet.</p>"} />
                  </div>
                </dl>
                {employerResearchForJob(job, importedJobChecks).research && (() => {
                  const shown = employerResearchForJob(job, importedJobChecks);
                  const research = shown.research!;
                  return <section class="mt-3 rounded-md border border-[var(--line)] bg-[var(--panel)] p-3 text-sm">
                    <h4 class="font-semibold">Employer research</h4>
                    {shown.showingEarlier && <p class="mt-2 rounded-md border border-[var(--line)] p-2" role="status">The latest check did not refresh the earlier supported employer assessment. {shown.latest?.employerResearch?.note} Showing findings from {shown.supported?.checkedAt ? new Date(shown.supported.checkedAt).toLocaleString() : "an earlier check"}; these were not revalidated by the latest attempt.</p>}
                    <p class="mt-2 font-semibold">{research.businessConsistency === "consistent" ? "The role appears consistent with the company’s business." : research.businessConsistency === "potential_mismatch" ? "The role may conflict with the company’s business. Review the details." : "There isn’t enough information to assess the business match yet."}</p>
                    <p class="mt-1 text-[var(--muted)]">{research.listingCorroborated ? "The careers page links to your saved listing." : "A careers-page link to your saved listing has not been confirmed."}{research.status === "completed" ? " AI-assisted assessment · " + research.confidence + " confidence." : " Employer research is incomplete."}</p>
                    {research.matchingRoleUrl && <p class="mt-2"><a class="underline" href={research.matchingRoleUrl} target="_blank" rel="noreferrer noopener">View role on the careers site</a>{!research.listingCorroborated && " — same-title role; compare it with your saved job."}</p>}
                    <details class="mt-3 border-t border-[var(--line)] pt-2">
                      <summary class="cursor-pointer font-semibold text-[var(--accent-strong)]">{research.businessConsistency === "consistent" ? "Why this fits the business — explanation & sources" : "Research details & sources"}</summary>
                      <div class="mt-3 space-y-3 break-words leading-6">
                        <p class="whitespace-pre-wrap">{research.note}</p>
                        <p class="text-xs text-[var(--muted)]">{research.status === "completed" ? "This is an AI-assisted interpretation, separate from your personal fit. It does not establish active hiring or guarantee safety. Correct the employer or job description below if needed." : "The direct listing check is shown separately above."}</p>
                        {research.sources.length > 0 && <p class="text-xs text-[var(--muted)]">Selected excerpts from the checked pages, not the full source text. Open each source to read it in full.</p>}
                        {research.sources.map(source => <blockquote class="border-l-2 border-[var(--line)] pl-3"><p class="whitespace-pre-wrap">{source.quote}</p><a class="underline" href={source.url} target="_blank" rel="noreferrer noopener">{source.purpose === "business" ? "Read business source" : "Read careers source"}</a></blockquote>)}
                      </div>
                    </details>
                  </section>;
                })()}
                <p class="mt-3 text-xs text-[var(--muted)]">
                  {job.capturedAt ? "Saved " + new Date(job.capturedAt).toLocaleString() + "." : "Saved at an unrecorded time."}
                </p>
                <form class="mt-3" method="post" action="/api/jobs/archive-import"><input type="hidden" name="importId" value={job.importId}/><input type="hidden" name="action" value={showingArchived ? "restore" : "archive"}/><button class="cip-action" type="submit">{showingArchived ? "Restore job" : "Not for me — archive"}</button></form>
                <div class="mt-3 flex flex-wrap gap-2">
                  {job.sourceUrl ? <span class="self-center text-xs text-[var(--muted)]">Checks the supplied listing and researches the named employer.</span> : null}
                  {job.sourceUrl && signedIn ? (
                    <form data-job-action="check" data-timeout-seconds="55" method="post" action="/api/jobs/verify-import" hx-post="/api/jobs/verify-import" hx-request='{"timeout":55000}' hx-target={`#job-action-result-${job.importId}`} hx-indicator={`#job-check-progress-${job.importId}`} hx-disabled-elt="find button">
                      <input type="hidden" name="importId" value={job.importId} />
                      <input type="hidden" name="returnTo" value="/opportunities#imported-jobs" />
                      <button class={isCheckStale(job) ? "cip-action cip-action-primary" : "cip-action"} type="submit">
                        {job.verification ? "Check it again" : "Check this listing"}
                      </button>
                      <div id={`job-check-progress-${job.importId}`} class="htmx-indicator cip-thinking-panel mt-3" role="status" aria-live="polite">
                        <div class="cip-thinking-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
                        <div class="min-w-0 flex-1"><p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Checking the listing and researching the employer</p><div class="cip-thinking-lines" aria-hidden="true"><span>Checking the supplied page...</span><span>Finding employer business and careers sources...</span><span>Checking attribution and business consistency...</span></div><p class="sr-only">The direct page check stops after ten seconds. Optional AI-assisted employer research has a separate deadline; the browser stops waiting after 55 seconds.</p><div class="cip-thinking-bar" aria-hidden="true"><span></span></div></div>
                      </div>
                    </form>
                  ) : null}
                  {signedIn ? (
                    <form data-job-action="assess" data-timeout-seconds="90" method="post" action="/api/jobs/assess-import" hx-post="/api/jobs/assess-import" hx-request='{"timeout":90000}' hx-target={`#job-action-result-${job.importId}`} hx-indicator={`#job-fit-progress-${job.importId}`} hx-disabled-elt="find button">
                      <input type="hidden" name="inlineResult" value="yes" />
                      <input type="hidden" name="importId" value={job.importId} />
                      <input type="hidden" name="returnTo" value="/opportunities#imported-jobs" />
                      <button class="cip-action" type="submit">
                        {fitForJob(job) ? "Assess fit again" : "Assess the fit"}
                      </button>
                      <div set:html={renderFitClarification()} />
                      <div id={`job-fit-progress-${job.importId}`} class="htmx-indicator cip-thinking-panel mt-3" role="status" aria-live="polite">
                        <div class="cip-thinking-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
                        <div class="min-w-0 flex-1"><p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Assessing fit using your CIP context</p><div class="cip-thinking-lines" aria-hidden="true"><span>Comparing this posting with your saved preferences and exclusions...</span><span>Reviewing your active career directions and saved evidence...</span><span>Keeping unknowns visible and saving the assessment...</span></div><p class="sr-only">Comparing this job with your saved career context. The assessment is separate from listing verification.</p><div class="cip-thinking-bar" aria-hidden="true"><span></span></div></div>
                      </div>
                    </form>
                  ) : null}
                </div>
                <div id={`job-action-result-${job.importId}`} class="mt-3 text-sm" aria-live="polite"></div>

                {signedIn ? <details class="mt-3 rounded-md border border-[var(--line)] p-3">
                  <summary class="cursor-pointer text-sm font-semibold text-[var(--accent-strong)]">Edit job details and source text</summary>
                  <form class="mt-3 grid gap-3" method="post" action="/api/jobs/update-import">
                    <input type="hidden" name="importId" value={job.importId} />
                    <input type="hidden" name="returnTo" value="/opportunities#imported-jobs" />
                    <div class="grid gap-3 md:grid-cols-2"><label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Job title<input name="title" required maxlength="200" value={job.title} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label><label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Employer<input name="employer" required maxlength="200" value={job.employer} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label></div>
                    <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">First source link<input name="sourceUrl" type="url" maxlength="2000" value={job.sourceLinks?.[0]?.url || job.sourceUrl} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label>
                    <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Text from the first source<textarea name="originalMaterial" rows="5" maxlength="40000" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case leading-6 text-[var(--foreground)]">{job.sourceLinks?.[0]?.material || job.originalMaterial}</textarea></label>
                    <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Second source link<input name="secondarySourceUrl" type="url" maxlength="2000" value={job.sourceLinks?.[1]?.url || ""} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label>
                    <label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Text from the second source<textarea name="secondaryMaterial" rows="5" maxlength="40000" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case leading-6 text-[var(--foreground)]">{job.sourceLinks?.[1]?.material || ""}</textarea></label>
                    <div class="grid gap-3 md:grid-cols-2"><label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Requisition or job ID<input name="requisitionId" maxlength="80" value={job.requisitionId || ""} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label><label class="grid gap-1 text-xs font-semibold uppercase text-[var(--muted)]">Location<input name="worksiteText" maxlength="200" value={job.worksiteText || ""} class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal normal-case text-[var(--foreground)]" /></label></div>
                    <button class="cip-action cip-action-primary justify-self-start" type="submit">Save revised job</button>
                    <p class="text-xs leading-5 text-[var(--muted)]">Edits are saved as a new version. Earlier text and assessments stay in your history; listing checks and fit assessments need to be repeated after edits.</p>
                  </form>
                </details> : null}

                {signedIn ? (
                  <details class="mt-3">
                    <summary class="cursor-pointer text-xs font-semibold text-[var(--accent-strong)]">
                      Set your own conclusion
                    </summary>
                    <form class="mt-2 grid gap-2" method="post" action="/api/jobs/assess-import">
                      <input type="hidden" name="importId" value={job.importId} />
                      <input type="hidden" name="returnTo" value="/opportunities#imported-jobs" />
                      <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
                        What you have decided
                        <select name="recommendation" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]">
                          <option value="apply">Apply</option>
                          <option value="talk_first">Talk to someone first</option>
                          <option value="check_funding">Research before investing effort</option>
                          <option value="monitor">Hold and watch</option>
                          <option value="skip">Not for me — archive</option>
                        </select>
                      </label>
                      <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
                        Why (optional)
                        <input name="note" maxlength="1000" placeholder="What does CIP not know about this?" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
                      </label>
                      <button class="cip-action justify-self-start" type="submit">Save my conclusion</button>
                      <p class="text-xs leading-5 text-[var(--muted)]">
                        Yours replaces CIP's on this card. Both are kept, so the difference can inform later analysis.
                      </p>
                    </form>
                  </details>
                ) : null}
                {checksForJob(job.importId, importedJobChecks).length ? (
                  <details class="mt-3">
                    <summary class="cursor-pointer text-xs font-semibold text-[var(--accent-strong)]">
                      Check history ({checksForJob(job.importId, importedJobChecks).length})
                    </summary>
                    <ol class="mt-2 grid gap-2">
                      {checksForJob(job.importId, importedJobChecks).map((entry) => (
                        <li class="rounded-md border border-[var(--line)] bg-[var(--panel)] p-2 text-xs leading-5 text-[var(--muted)]">
                          <span class="font-semibold text-[var(--foreground)]">
                            {entry.checkedAt ? new Date(entry.checkedAt).toLocaleString() : "Time not recorded"}
                          </span>
                          {" \u2014 " + readableState(entry.state)}
                          {entry.note ? <p class="mt-1">{entry.note}</p> : null}
                          {entry.employerResearch && <p class="mt-1">Employer research: {entry.employerResearch.note}</p>}
                          {entry.observations?.map((observation) => <p class="mt-1">Observation: {observation.detail}</p>)}
                        </li>
                      ))}
                    </ol>
                    <p class="mt-2 text-xs leading-5 text-[var(--muted)]">
                      Earlier checks are kept, so a posting that changed can show what it was before.
                    </p>
                  </details>
                ) : null}
              </article>
            ))}</div></details>)}
          </div>
        </div>
      ) : null}
    </section>
  </main>
  <script is:inline>
    // The import form is reached from the top of the page, so opening it must
    // not cost a reload or a scroll hunt. Also handles landing on the anchor
    // directly, e.g. from a bookmark or the back button.
    (function () {
      var panel = document.getElementById("bring-a-job");
      if (!panel) return;

      function openPanel(focusFirst) {
        panel.open = true;
        if (!focusFirst) return;
        // The anchor's own hash navigation resets focus to the document after
        // this handler runs, so claim it just afterwards - otherwise the cursor
        // never reaches the first field. A timeout rather than an animation
        // frame, because frames do not fire while a tab is hidden.
        window.setTimeout(function () {
          var field = panel.querySelector("input[name=title]");
          if (field) field.focus({ preventScroll: true });
        }, 0);
      }

      document.querySelectorAll("[data-open-import]").forEach(function (trigger) {
        trigger.addEventListener("click", function () {
          openPanel(true);
        });
      });

      if (location.hash === "#imported-jobs" || location.hash === "#bring-a-job") openPanel(false);
      window.addEventListener("hashchange", function () {
        if (location.hash === "#imported-jobs" || location.hash === "#bring-a-job") openPanel(true);
      });

      document.body.addEventListener("fitAssessmentReady", function (event) {
        var result = document.getElementById(event.detail && event.detail.targetId);
        if (!result) return;
        result.querySelectorAll("details").forEach(function (details) { details.open = false; });
        var article = result.closest("article");
        var button = article && article.querySelector('[data-job-action="assess"] > button[type="submit"]');
        if (button) button.textContent = "Assess fit again";
        result.focus({ preventScroll: true });
        result.scrollIntoView({ block: "start", behavior: "auto" });
      });
      var jobTimers = new WeakMap();
      function finishJobRequest(form) {
        clearTimeout(jobTimers.get(form));
        form.classList.remove("htmx-request");
        form.querySelectorAll(".htmx-request").forEach(function (indicator) { indicator.classList.remove("htmx-request"); });
        form.querySelectorAll("button").forEach(function (button) { button.disabled = false; });
      }
      document.body.addEventListener("htmx:beforeRequest", function (event) {
        var form = event.detail && event.detail.elt && event.detail.elt.closest("[data-job-action]");
        if (!form) return;
        clearTimeout(jobTimers.get(form));
        jobTimers.set(form, setTimeout(function () {
          form.dispatchEvent(new Event("htmx:abort", { bubbles: true }));
          finishJobRequest(form);
          var result = document.querySelector(form.getAttribute("hx-target"));
          if (result) result.textContent = "The page stopped waiting. The check may still finish saving; reload to see its status before retrying.";
        }, Number(form.getAttribute("data-timeout-seconds") || "30") * 1000));
      });
      document.body.addEventListener("htmx:afterRequest", function (event) {
        var form = event.detail && event.detail.elt && event.detail.elt.closest("[data-job-action]");
        if (form) finishJobRequest(form);
      });
      document.body.addEventListener("htmx:beforeSwap", function (event) {
        var detail = event.detail;
        var target = detail && detail.target;
        if (target && target.id && (target.id.indexOf("job-action-result-") === 0 || target.id.indexOf("fit-result-") === 0) && detail.xhr && detail.xhr.status >= 400) {
          // htmx otherwise suppresses error response bodies, which made a
          // failed check or assessment look exactly like a dead button.
          detail.shouldSwap = true;
          detail.isError = false;
        }
      });
      document.body.addEventListener("htmx:sendError", function (event) {
        var source = event.detail && event.detail.elt ? event.detail.elt : event.target;
        var form = source && source.closest && source.closest("[data-job-action]");
        if (!form) return;
        var result = document.querySelector(form.getAttribute("hx-target"));
        if (result) result.textContent = "The connection failed. Reload to check whether a result was saved before retrying.";
      });
      document.body.addEventListener("htmx:timeout", function (event) {
        var source = event.detail && event.detail.elt ? event.detail.elt : event.target;
        var form = source && source.closest && source.closest("[data-job-action]");
        if (!form) return;
        var result = document.querySelector(form.getAttribute("hx-target"));
        if (result) result.textContent = "This request exceeded " + (form.getAttribute("data-timeout-seconds") || "30") + " seconds. The page stopped waiting. Reload to check whether a result was saved before retrying.";
      });
    })();
  </script>
</Layout>
