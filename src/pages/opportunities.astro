---
import Layout from "../layouts/Layout.astro";
import { loadJobSearchConfig } from "../lib/cip/job-search-config";
import { loadDueState, loadLatestRunView } from "../lib/cip/job-search-run";
import { renderJobSearchPanel } from "../lib/cip/job-search-view";
import { loadStoredSearchPreferences, type StoredSearchPreferences } from "../lib/cip/search-preferences";
import { readJobSearchEnv } from "../lib/cip/server-env";
import { createServer } from "../lib/supabase/server";

type SavedEmployer = {
  id: string;
  name: string;
  region: string;
  priority: string;
  careers_url: string | null;
};

let signedIn = false;
let loadError = "";
let panelHtml = "";
let employers: SavedEmployer[] = [];
let preferences: StoredSearchPreferences | null = null;
let preferencesError = "";

if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const supabase = createServer(Astro.cookies);
    const {
      data: { user },
    } = await supabase.auth.getUser();
    signedIn = Boolean(user);

    if (user) {
      const [employerResult, storedPreferences] = await Promise.all([
        supabase
          .from("watched_employers")
          .select("id,name,region,priority,careers_url")
          .eq("user_id", user.id)
          .order("fit_score", { ascending: false })
          .limit(100),
        loadStoredSearchPreferences(supabase, user.id).catch((error: Error) => error),
      ]);

      if (employerResult.error) loadError = employerResult.error.message;
      else employers = (employerResult.data ?? []) as SavedEmployer[];
      if (storedPreferences instanceof Error) preferencesError = storedPreferences.message;
      else preferences = storedPreferences;

      // The weekly search panel: latest run, due state, and whether the provider is configured.
      try {
        const config = loadJobSearchConfig(readJobSearchEnv);
        const latestRun = await loadLatestRunView(supabase, user.id);
        const due = await loadDueState(supabase, user.id, config, new Date().toISOString());
        panelHtml = renderJobSearchPanel(latestRun, { runKey: crypto.randomUUID(), due, configured: config.configured });
      } catch (error) {
        const detail = error instanceof Error ? error.message : "unknown error";
        panelHtml = `<div id="job-search-panel"><p class="text-sm text-red-800">Could not load the weekly job search: ${detail.replace(/[<>&]/g, "")}. If this mentions a missing table, apply the latest Supabase migrations.</p></div>`;
      }
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Unable to load opportunities.";
  }
}

const workModeLabel: Record<string, string> = { onsite: "On-site", hybrid: "Hybrid", remote: "Remote" };
const withCareerPage = employers.filter((employer) => employer.careers_url);
---

<Layout title="CIP Opportunities">
  <main class="cip-page-shell mx-auto w-full max-w-5xl px-5 py-8">
    <section class="cip-card rounded-lg p-6">
      <p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Opportunities</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Verified openings, checked on their own pages.</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">
        Once a week, the search reads your target employers' career pages, then the job sites you trust, then the open web.
        Every posting is opened on its own page and checked before it is called open. Nothing here is a bare match score.
        Roles that are far away, past their deadline, or on your exclusion list are kept and shown separately, not hidden.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="cip-fancy-button cip-fancy-button-secondary" href="/preferences"><span>Search preferences</span></a>
        <a class="cip-fancy-button cip-fancy-button-secondary" href="/employers"><span>Employers</span></a>
      </div>

      {!signedIn ? (
        <p class="mt-6 rounded-md border border-[var(--line)] bg-[var(--background)] p-4 text-sm">
          <a class="font-semibold underline" href="/login">Sign in</a> to run and review your weekly search.
        </p>
      ) : null}
      {loadError ? <p class="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">{loadError}</p> : null}

      {signedIn && panelHtml ? (
        <div class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5">
          <Fragment set:html={panelHtml} />
        </div>
      ) : null}
    </section>

    {signedIn ? (
      <section class="cip-card mt-6 rounded-lg p-6">
        <h2 class="text-lg font-semibold">What this search covers</h2>
        <p class="mt-1 text-sm text-[var(--muted)]">Change any of this on Search preferences. Anything unset is treated as unknown, never as "no limit."</p>
        {preferencesError ? <p class="mt-3 text-sm text-red-800">Could not load your preferences: {preferencesError}</p> : null}
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Places</h3>
            {preferences && preferences.anchorRequests.length ? (
              <ul class="mt-2 grid gap-1 text-sm">
                {preferences.anchorRequests.map((place) => <li>{place.label} <span class="text-[var(--muted)]">within {place.radiusMiles} mi</span></li>)}
              </ul>
            ) : (
              <p class="mt-2 text-sm text-[var(--muted)]">None saved. Add at least one place, or accept remote work, so the local search has somewhere to look.</p>
            )}
            {preferences && preferences.workModes.length ? (
              <p class="mt-3 text-xs text-[var(--muted)]">Accepted: {preferences.workModes.map((mode) => workModeLabel[mode] ?? mode).join(", ")}</p>
            ) : null}
            {preferences?.salaryFloorUsd ? (
              <p class="mt-1 text-xs text-[var(--muted)]">Minimum salary: ${preferences.salaryFloorUsd.toLocaleString("en-US")} a year</p>
            ) : null}
          </div>
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Job sites you trust</h3>
            {preferences && preferences.preferredSources.length ? (
              <ul class="mt-2 grid gap-1 text-sm">
                {preferences.preferredSources.map((site) => <li>{site}</li>)}
              </ul>
            ) : (
              <p class="mt-2 text-sm text-[var(--muted)]">None yet. The search still checks employer pages and the open web.</p>
            )}
            <p class="mt-3 text-xs text-[var(--muted)]">Sites that require a login (LinkedIn, Indeed) cannot be searched.</p>
          </div>
          <div class="rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <h3 class="text-sm font-semibold">Target employers</h3>
            <p class="mt-2 text-sm">{employers.length} saved <span class="text-[var(--muted)]">({withCareerPage.length} with a career page on file)</span></p>
            <p class="mt-3 text-xs text-[var(--muted)]">The search opens their career pages first. It finds a page itself when none is on file.</p>
          </div>
        </div>

        {employers.length ? (
          <details class="mt-5 rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
            <summary class="cursor-pointer text-sm font-semibold">Saved employers ({employers.length})</summary>
            <ul class="mt-3 grid gap-2 text-sm">
              {employers.map((employer) => (
                <li class="flex flex-wrap items-baseline justify-between gap-2">
                  <span><span class="font-semibold">{employer.name}</span> <span class="text-[var(--muted)]">{employer.region.replaceAll("_", " ")}</span></span>
                  {employer.careers_url ? (
                    <a class="text-xs underline" href={employer.careers_url} target="_blank" rel="noopener noreferrer">Career page</a>
                  ) : (
                    <span class="text-xs text-[var(--muted)]">No career page on file</span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ) : null}
      </section>
    ) : null}
  </main>
</Layout>
