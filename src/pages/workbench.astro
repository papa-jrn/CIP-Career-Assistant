---
import { goalContext, loadSavedGoalEvidence, type GoalReview } from "../lib/cip/goal-synthesis";
import { renderGoalReviews } from "../lib/cip/goal-synthesis-view";
import { advisorWithLaneHistory, loadAdvisorLaneHistory } from "../lib/cip/lane-continuity";
import { buildTargetLanes } from "../lib/cip/resume-asset-context";
import { loadLatestRunView } from "../lib/cip/job-search-run";
import { loadArchiveContext, isImportedArchived } from "../lib/cip/job-archive";
import Layout from "../layouts/Layout.astro";
import { createServer } from "../lib/supabase/server";
import { parseAnalysisAdvisor, parseIntakeSource } from "../lib/cip/resume-asset-context";
import type { AdvisorAnalysis } from "../lib/cip/advisor";
import { loadWorkActions, type WorkAction } from "../lib/cip/workbench-actions";
import { IMPORTED_JOB_SOURCE_TYPE, latestImportedJobs, parseImportedJob } from "../lib/cip/imported-jobs";
import { IMPORTED_JOB_FIT_SOURCE_TYPE, latestCurrentFitFor, parseImportedJobFit, readableRecommendation, type FitAssessment } from "../lib/cip/imported-job-fit";
import { IMPORTED_JOB_CHECK_SOURCE_TYPE, applyLatestCheck, parseImportedJobCheck, readableState, type ImportedJobCheck } from "../lib/cip/imported-job-checks";

const views = [{ key: "overview", label: "Overview" }, { key: "work", label: "My work" }, { key: "changes", label: "What changed" }];
const requested = Astro.url.searchParams.get("view");
const view = views.some(v => v.key === requested) ? requested : "overview";
let signedIn = false;
let hasIntake = false;
let advisor: Partial<AdvisorAnalysis> | null = null;
let analysisAt: string | null = null;
let actions: WorkAction[] = [];
let pending = 0;
let pendingGoals = 0;
let savedGoalIds: string[] = [];
let error = "";
let jobsSummary: { total: number; checkedOpen: number; searchedAt: string | null } | null = null;
let importedJobs: ReturnType<typeof parseImportedJob>[] = [];
let importedFits: FitAssessment[] = [];
let importedChecks: ImportedJobCheck[] = [];
if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const db = createServer(Astro.cookies);
    const { data: { user }, error: authError } = await db.auth.getUser();
    if (authError && authError.name !== "AuthSessionMissingError") throw new Error("Unable to check your sign-in. Please retry.");
    signedIn = Boolean(user);
    if (user) {
      const [intake, analysis, work] = await Promise.all([
        db.from("career_sources").select("extracted_text").eq("user_id", user.id).eq("source_type", "resume_intake").order("created_at", { ascending: false }).limit(1).maybeSingle(),
        db.from("career_sources").select("extracted_text,created_at").eq("user_id", user.id).eq("source_type", "evidence_analysis").order("created_at", { ascending: false }).limit(1).maybeSingle(),
        loadWorkActions(db, user.id),
      ]);
      if (intake.error || analysis.error) throw new Error("Your saved direction could not be loaded. Please retry.");
      hasIntake = Boolean(parseIntakeSource(intake.data?.extracted_text ?? null));
      advisor = advisorWithLaneHistory(await loadAdvisorLaneHistory(db, user.id), parseIntakeSource(intake.data?.extracted_text ?? null)?.advisor ?? null);
      analysisAt = analysis.data?.created_at ?? null;
      actions = work;
      try {
        const savedJobs = await loadLatestRunView(db, user.id);
        if (savedJobs) jobsSummary = { total: savedJobs.observations.length, checkedOpen: savedJobs.observations.filter(job => job.verification_state === "verified_open").length, searchedAt: savedJobs.run.finished_at };
      } catch { /* The jobs link remains available when its summary cannot load. */ }
      const [imports, fits, checks] = await Promise.all([
        db.from("career_sources").select("extracted_text").eq("user_id", user.id).eq("source_type", IMPORTED_JOB_SOURCE_TYPE).order("created_at", { ascending: false }).limit(12),
        db.from("career_sources").select("extracted_text,created_at").eq("user_id", user.id).eq("source_type", IMPORTED_JOB_FIT_SOURCE_TYPE).order("created_at", { ascending: false }).limit(100),
        db.from("career_sources").select("extracted_text,created_at").eq("user_id", user.id).eq("source_type", IMPORTED_JOB_CHECK_SOURCE_TYPE).order("created_at", { ascending: false }).limit(100),
      ]);
      importedFits = (fits.data ?? []).map((row: { extracted_text: string | null; created_at: string }) => parseImportedJobFit(row.extracted_text, row.created_at)).filter(Boolean) as FitAssessment[];
      importedChecks = (checks.data ?? []).map((row: { extracted_text: string | null; created_at: string }) => parseImportedJobCheck(row.extracted_text, row.created_at)).filter(Boolean) as ImportedJobCheck[];
      importedJobs = latestImportedJobs((imports.data ?? []).map((row: { extracted_text: string | null }) => parseImportedJob(row.extracted_text)).filter(Boolean)).map(job => applyLatestCheck(job!, importedChecks));
      const archive = await loadArchiveContext(db, user.id);
      importedJobs = importedJobs.filter(job => !isImportedArchived(job!, importedFits, archive.dispositions, archive.events));
      const goals = await loadSavedGoalEvidence(db, user.id);
      const reviewContext = goalContext({ currentGoalUpdates: goals, priorAnalysis: advisor }, []);
      pendingGoals = reviewContext.pending.length;
      savedGoalIds = [...reviewContext.stated.keys(), ...(advisor?.goalReviews ?? []).map(review => review.inputId)];
      let query = db.from("career_sources").select("id", { count: "exact", head: true }).eq("user_id", user.id)
        .in("source_type", ["resume_intake", "evidence_response", "source_analysis", "conversation_outcome"]);
      if (analysisAt) query = query.gt("created_at", analysisAt);
      const count = await query;
      if (count.error) throw new Error("Could not check pending updates. Please retry before updating strategy.");
      pending = count.count ?? 0;
    }
  } catch (e) { error = e instanceof Error ? e.message : "Could not load your workspace."; }
}
const visibleActions = actions.filter(a => a.status === "active");
const savedActions = actions.filter(a => a.status !== "active");
const changeLog = advisor?.changeLog;
const incomingContext = (Astro.url.searchParams.get("context") ?? "").slice(0, 300);
const incomingTitle = (Astro.url.searchParams.get("title") ?? "").slice(0, 180);
const correctionId = Astro.url.searchParams.get("goalId") ?? "";
const correctingGoal = savedGoalIds.includes(correctionId) ? correctionId : "";
const existingHandoff = actions.find(a => a.title.trim().toLowerCase() === incomingTitle.trim().toLowerCase() && a.context.trim().toLowerCase() === incomingContext.trim().toLowerCase());
const selectedAction = actions.find(a => a.actionId === Astro.url.searchParams.get("action")) ?? existingHandoff ?? visibleActions[0];
const lanes = advisor?.roleBriefs?.length ? buildTargetLanes(null, advisor).slice(0, 3) : [];
const needsUpdate = pending > 0 || pendingGoals > 0;
const saved = ["work", "update"].includes(Astro.url.searchParams.get("saved") ?? "");
---
<Layout title="Workbench — CIP" description="Connect your experience to career directions that fit you. Test them, learn what works, and refine your plan as you go.">
<main class="wb">
  <header class="wb-heading"><div><p class="wb-eyebrow">Workbench</p><h1>Keep your direction. Make your next move.</h1><p class="wb-intro">Connect your experience to career directions that fit you. Test them, learn what works, and refine your plan as you go.</p></div>{signedIn && !error && <a class="wb-button" href="#capture">Add an update</a>}</header>
  {error ? <section class="wb-section" role="alert"><h2>Your workspace could not be loaded</h2><p>{error}</p><a href="/workbench">Retry</a></section> : !signedIn ? <section class="wb-section"><h2>Your work stays with you</h2><p>Sign in to capture updates, keep your actions, and review your direction.</p><a class="wb-button" href="/login">Sign in</a></section> : <>
    {!hasIntake && <section class="wb-notice"><p class="wb-eyebrow">Start here</p><h2>Find your first direction</h2><p>Start with your experience, deepen the evidence, then choose an action. You can revisit your direction whenever life changes.</p><div class="wb-links"><a href="/intake">Tell your story</a><a href="/evidence">Dig deeper</a><a href="/assets">Review your lanes</a></div></section>}
    {lanes.length > 0 && <section class="wb-map" aria-label="Your career map"><div class="wb-map-heading"><div><h2>Your career map</h2><p class="wb-small">Focus order is separate from market evidence.</p></div><a href="/assets">Review your lanes</a></div><div class="wb-lanes">{lanes.map((lane, i) => <a class:list={["wb-lane", { "wb-lane-primary": i === 0 }]} href="/assets"><span class="wb-priority">{["Primary focus", "Secondary focus", "Tertiary focus"][i]}</span><strong>{lane.role}</strong><i class="ph ph-caret-right" aria-hidden="true"></i></a>)}</div><button class="wb-lane-toggle" type="button" aria-expanded="false" data-lane-toggle>Show all career lanes</button></section>}
    <nav class="wb-loop" aria-label="Career work loop"><a href="/workbench?view=work"><i class="ph ph-list-checks" aria-hidden="true"></i>Choose work</a><a href={selectedAction ? `/workbench?view=work&action=${selectedAction.actionId}#research-editor` : "#capture"}><i class="ph ph-note-pencil" aria-hidden="true"></i>Capture findings</a><a href={view === "changes" ? "/workbench#strategy" : "#strategy"}><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Update strategy</a><a href="/workbench?view=changes"><i class="ph ph-sparkle" aria-hidden="true"></i>Review changes</a></nav>
    <nav class="wb-tabs" aria-label="Workbench views"><a href="/workbench?view=overview" aria-current={view === "overview" ? "page" : undefined}>Overview</a><a href="/workbench?view=work" aria-current={view === "work" ? "page" : undefined}>My work</a><a href="/opportunities">Jobs & opportunities</a><a href="/workbench?view=changes" aria-current={view === "changes" ? "page" : undefined}>What changed</a></nav>
    {(view === "overview" || view === "work") && <section id="jobs" class="wb-jobs" aria-label="Saved job listings">
      <div class="wb-jobs-summary"><h2>Jobs to review</h2><p class="wb-small">{jobsSummary ? `${jobsSummary.total} listings in your latest search · ${jobsSummary.checkedOpen} marked open at that check${jobsSummary.searchedAt ? ` · Search completed ${jobsSummary.searchedAt.slice(0,10)}` : ""}.` : "No search results loaded."} {importedJobs.length} imported job{importedJobs.length === 1 ? "" : "s"}. Listing status and personal fit are separate.</p></div>
      <div class="wb-jobs-actions"><a class="wb-button wb-outline" href="/opportunities#job-search-panel">View searched listings</a><a class="wb-button" href="/opportunities#imported-jobs">Bring in a job</a></div>
      {importedJobs.length > 0 && <div class="wb-imported-jobs"><h3>Jobs you brought in</h3>{importedJobs.map(job => { const fit = latestCurrentFitFor(job!, importedFits); const actionId = job!.importId.replace(/[^A-Za-z0-9_-]/g, ""); return <article><div class="wb-imported-title"><strong>{job!.title}</strong><span>{job!.employer}</span></div><p>{job!.verification ? `Listing check: ${readableState(job!.verification.state)} · ${job!.verification.checkedAt.slice(0,10)}` : "Listing not checked yet"} · {fit ? `Fit: ${fit.analysis?.rubricVersion === 3 && fit.analysis?.score != null ? `${fit.analysis.score}/10 · ` : ""}${readableRecommendation(fit.recommendation)} (${fit.basis === "user" ? "your decision" : fit.basis === "ai_assisted" ? "AI-assisted CIP assessment" : "CIP assessment"})` : "Fit not assessed yet"}</p><div class="wb-job-actions"><div class="wb-job-button-row">{signedIn && <form method="post" action="/api/jobs/assess-import" hx-post="/api/jobs/assess-import" hx-request='{"timeout":90000}' hx-target={`#wb-job-result-${actionId}`} hx-indicator={`#wb-job-progress-${actionId}`} hx-disabled-elt="find button"><input type="hidden" name="importId" value={job!.importId}/><input type="hidden" name="returnTo" value="/workbench?view=overview#jobs"/><button class="wb-button" type="submit">{fit ? "Assess fit again" : "Assess fit"}</button><div id={`wb-job-progress-${actionId}`} class="htmx-indicator cip-thinking-panel mt-2" role="status" aria-live="polite"><div class="cip-thinking-orbit" aria-hidden="true"><span></span><span></span><span></span></div><div class="min-w-0 flex-1"><p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Assessing fit using your CIP context</p><div class="cip-thinking-lines" aria-hidden="true"><span>Reviewing your saved direction and evidence...</span><span>Comparing what you saved with this posting...</span><span>Keeping unknowns clear...</span></div><div class="cip-thinking-bar" aria-hidden="true"><span></span></div></div></div></form>}<a class="wb-button wb-outline" href="/opportunities#imported-jobs">Job details and source text</a></div><div id={`wb-job-result-${actionId}`} class="text-sm" aria-live="polite"></div></div></article>; })}</div>}
    </section>}
    {saved && <p class="wb-notice" role="status">Saved. {needsUpdate ? "Your findings are waiting for strategy analysis." : "Your work has been recorded."} <a href="#strategy">Review strategy status</a></p>}
    {Astro.url.searchParams.get("snapshot") === "pending" && <p class="wb-notice" data-announce tabindex="-1" role="status">Analysis saved. The briefing snapshot could not refresh; your inputs and goal reviews are safe.</p>}
    {(view === "overview" || view === "work") && <div class="wb-workspace">
      <section class="wb-work" id="research-editor">
        {selectedAction ? <>
          <p class="wb-eyebrow">{selectedAction.kind} · {selectedAction.status}</p><h2>{selectedAction.title}</h2><p class="wb-small">{selectedAction.context || "Record what you learn and decide where to put your next effort."}</p>
          <form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#outcome-result" hx-disabled-elt="find button" hx-indicator="#outcome-progress">
            <input type="hidden" name="operation" value="outcome"/><input type="hidden" name="actionId" value={selectedAction.actionId}/>
            <label>What did you learn?<span class="wb-small">Capture what matters for your next move. An unknown answer is useful too.</span><textarea name="note" maxlength="12000" rows="4" placeholder="Add your findings…"></textarea></label>
            <label>Source link <span class="wb-small">Optional. Saved as a reference; adding a link does not verify or read it.</span><input type="url" name="sourceUrl" maxlength="2000" placeholder="https://"/></label>
            <fieldset><legend>What is your conclusion?</legend><p class="wb-small">An unknown outcome means there is not enough information yet; it does not mean a poor fit.</p><label class="wb-choice"><input type="radio" name="conclusion" value="continue"/>Continue exploring</label><label class="wb-choice"><input type="radio" name="conclusion" value="hold"/>Hold this direction</label><label class="wb-choice"><input type="radio" name="conclusion" value="unknown"/>Unable to establish</label></fieldset>
            <div class="wb-links"><button class="wb-button" name="status" value={selectedAction.status} type="submit">Save findings</button>{selectedAction.status !== "completed" && <button class="wb-button wb-outline" name="status" value="completed" type="submit">Save and finish task</button>}</div>
            <details><summary>Other task decisions</summary><div class="wb-links">{selectedAction.status !== "active" && <button name="status" value="active" type="submit">Reopen task</button>}<button name="status" value="deferred" type="submit">Defer task</button><button name="status" value="dismissed" type="submit">Dismiss task</button></div><p class="wb-small">Any findings entered above are saved with the decision.</p></details>
            <p id="outcome-progress" class="htmx-indicator" role="status">Saving your findings…</p><div id="outcome-result" aria-live="polite"></div>
          </form>
          <details class="wb-history"><summary>Saved history ({selectedAction.history.length})</summary>{selectedAction.history.map(h => <article><p class="wb-small">{h.at.slice(0,10)} · {h.status}</p><p class="wb-preserve">{h.note || "Task status recorded."}</p>{h.conclusion && <p>Conclusion: {h.conclusion === "unknown" ? "Unable to establish" : h.conclusion}</p>}{h.sourceUrl && /^https?:\/\//i.test(h.sourceUrl) && <a href={h.sourceUrl} target="_blank" rel="noopener noreferrer">View saved source</a>}</article>)}</details>
        </> : <>
          <p class="wb-eyebrow">Your next move</p><h2>{incomingTitle ? "Start this next move" : "Give your next step a place to happen"}</h2><p>Research an employer, check funding, or test a career direction. Save what you find here, then bring the learning into your strategy.</p>
          <form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#create-result" hx-disabled-elt="find button"><input type="hidden" name="operation" value="create"/><label>What will you work on?<input name="title" required minlength="4" maxlength="180" value={incomingTitle} placeholder="Research an employer I am considering"/></label><label>Related employer, person, or direction<input name="context" maxlength="300" value={incomingContext}/></label><label>Type<select name="kind"><option value="research">Employer research</option><option value="funding">Funding check</option><option value="experiment">Career experiment</option></select></label><button class="wb-button" type="submit">Start this work</button><div id="create-result" aria-live="polite"></div></form>
        </>}
      </section>
      <aside class="wb-context"><h2>{selectedAction ? "Why this work?" : "A direction you can act on"}</h2><p class="wb-small">Keep the bigger picture close while you work.</p>
        <a class="wb-context-link" href={selectedAction ? `/employers?workAction=${selectedAction.actionId}` : "/employers"}><i class="ph ph-buildings" aria-hidden="true"></i><span><strong>Employer research</strong><small>Review employers and their dossiers</small></span><i class="ph ph-caret-right" aria-hidden="true"></i></a><a class="wb-context-link" href={selectedAction ? `/assets?workAction=${selectedAction.actionId}` : "/assets"}><i class="ph ph-compass" aria-hidden="true"></i><span><strong>Your career lanes</strong><small>Review supporting evidence and gaps</small></span><i class="ph ph-caret-right" aria-hidden="true"></i></a><a class="wb-context-link" href={selectedAction ? `/evidence?workAction=${selectedAction.actionId}` : "/evidence"}><i class="ph ph-file-text" aria-hidden="true"></i><span><strong>Evidence and questions</strong><small>Dig deeper or analyze linked sources</small></span><i class="ph ph-caret-right" aria-hidden="true"></i></a>
        {hasIntake && <section id="strategy" class:list={["wb-strategy", { "wb-pending": needsUpdate }]}><p class="wb-eyebrow">{needsUpdate ? "Ready when you are" : "Strategy status"}</p><h3>{needsUpdate ? "Saved learning. Strategy update pending." : "No saved updates waiting for analysis."}</h3>{pendingGoals > 0 && <p>{pendingGoals} goal interpretation{pendingGoals === 1 ? "" : "s"} still pending.</p>}<p class="wb-small">{pending} new saved input{pending === 1 ? "" : "s"}. Completing a task and analyzing its findings are separate steps.</p><form method="post" action="/api/evidence/analyze" hx-post="/api/evidence/analyze" hx-headers='{"X-CIP-Workbench":"true"}' hx-target="#strategy-result" hx-indicator="#strategy-progress" hx-disabled-elt="find button"><button class="wb-button wb-outline" type="submit">{needsUpdate ? "Update my strategy" : "Review my strategy again"}</button></form><p id="strategy-progress" class="htmx-indicator" role="status">Updating from saved inputs. Your notes remain safe if this fails.</p><div id="strategy-result" aria-live="polite"></div><details><summary>What gets analyzed?</summary><p class="wb-small">Saved evidence, conversations, and goals. Links need source analysis in Evidence first. This does not launch a job search or generate resumes.</p></details></section>}
        <a class="wb-context-link" href="/workbench?view=changes"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><span><strong>What changed last time?</strong><small>Review your latest strategy changes</small></span></a>
      </aside>
    </div>}
    {(view === "overview" || view === "work") && <section class="wb-section"><div class="wb-map-heading"><h2>Your work</h2><a href={actions.length ? "/workbench?view=work&new=1#new-work" : "#research-editor"}>Add a next move</a></div>{actions.length ? <div class="wb-queue">{[...visibleActions,...savedActions].map(a => <a id={`action-${a.actionId}`} href={`/workbench?view=work&action=${a.actionId}#research-editor`}><strong>{a.title}</strong><span>{a.context}</span><small>{a.status}</small><i class="ph ph-caret-right" aria-hidden="true"></i></a>)}</div> : <p class="wb-small">No saved actions yet. Start one above, or bring a recommendation here from your strategy.</p>}{actions.length > 0 && <details id="new-work" open={Astro.url.searchParams.has("new") || Boolean(incomingTitle && !existingHandoff)}><summary>Add a next move</summary><form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#new-result" hx-disabled-elt="find button"><input type="hidden" name="operation" value="create"/><label>Specific action<input name="title" minlength="4" maxlength="180" required value={incomingTitle}/></label><label>Related employer, person, or direction<input name="context" maxlength="300" value={incomingContext}/></label><label>Type<select name="kind"><option value="research">Research</option><option value="funding">Funding check</option><option value="experiment">Career experiment</option></select></label><button class="wb-button" type="submit">Add action</button><div id="new-result" aria-live="polite"></div></form></details>}</section>}
    {view === "overview" && <details class="wb-section"><summary>Your current direction · {analysisAt?.slice(0,10) ?? "Not analyzed yet"}</summary><p>{advisor?.summary || "Start with your story and evidence to build your first direction."}</p><p class="wb-small">{advisor?.mode === "ai" ? "AI-derived interpretation. Review and correct it." : "Interpretation from your saved inputs."}</p><div class="wb-links"><a href="#capture">Correct your direction</a><a href="/assets">Review lanes and positioning</a></div><div set:html={renderGoalReviews(advisor?.goalReviews)}/></details>}
    {view === "changes" && <section class="wb-section"><p class="wb-eyebrow">What changed</p><h2>{changeLog?.hasChanges ? "Your latest strategy changes" : "Your latest analysis"}</h2><p>{changeLog?.summary || "No change explanation yet. Add evidence and update your strategy to establish a baseline."}</p>{changeLog && [{title:"Direction added or revised",items:changeLog.directionChanges ?? []},{title:"Implications for your plan",items:changeLog.planImplications ?? []},{title:"Strengthened",items:changeLog.strengthened},{title:"Weakened",items:changeLog.weakened},{title:"Questions answered",items:changeLog.newlyAnswered}].map(group => group.items?.length > 0 && <section><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></section>)}<div set:html={renderGoalReviews(advisor?.goalReviews)}/><div class="wb-links"><a href="/workbench?view=work">Choose your next move</a><a href="/report">View strategy report / export</a><a href="/workbench#strategy">Review strategy status</a></div></section>}
    <details id="capture" class="wb-section" open={Boolean(correctingGoal)}><summary>Add an update · research, a goal, or a correction</summary><p>Bring back what you learn. Your original history stays intact.</p><form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#capture-result" hx-disabled-elt="find button"><input type="hidden" name="operation" value="capture"/>{correctingGoal && <><input type="hidden" name="supersedesGoalId" value={correctingGoal}/><p>Describe the corrected intention. The original remains in your history.</p></>}<label>What kind of update?<select name="kind"><option value="research" selected={!correctingGoal}>Research finding</option><option value="funding">Funding finding</option><option value="goal" selected={Boolean(correctingGoal)}>Goal or interest change</option><option value="experiment">Experiment result</option><option value="evidence">Evidence or correction</option></select></label><label>Related employer, person, or direction<input name="context" maxlength="300" value={incomingContext}/></label><label>Your update<textarea name="note" required minlength="12" maxlength="12000" rows="5"></textarea></label><label>Source link (optional)<input type="url" name="sourceUrl" maxlength="2000" placeholder="https://"/></label><p class="wb-small">Saved as information you provide, not independently verified proof. Goals are intentions. <a href="/network">Capture a structured conversation in People</a>.</p><button class="wb-button" type="submit">Save update</button><div id="capture-result" aria-live="polite"></div></form></details>
  </>}
</main>
</Layout>
<script>
  document.querySelector("[data-lane-toggle]")?.addEventListener("click", event => { const button = event.currentTarget as HTMLButtonElement; const expanded = button.getAttribute("aria-expanded") !== "true"; button.setAttribute("aria-expanded", String(expanded)); button.textContent = expanded ? "Show primary lane only" : "Show all career lanes"; button.closest(".wb-map")?.classList.toggle("wb-all-lanes", expanded); });
  const revealHash = () => { const node = document.getElementById(location.hash.slice(1)); if (node instanceof HTMLDetailsElement) node.open = true; };
  if (/^#action-[a-f0-9-]{36}$/.test(location.hash)) { const target = new URL(location.href); target.searchParams.set("action", location.hash.slice(8)); target.hash = "research-editor"; location.replace(target); }
  revealHash(); window.addEventListener("hashchange", revealHash);
  document.body.addEventListener("htmx:beforeSwap", event => { const detail = (event as CustomEvent<{target?:HTMLElement;xhr?:XMLHttpRequest;shouldSwap:boolean;isError:boolean}>).detail; if(detail?.target?.closest(".wb") && detail.xhr && detail.xhr.status >=400){detail.shouldSwap=true;detail.isError=false;} });
  const showJobActionError = (event: Event, message: string) => { const detail = (event as CustomEvent<{elt?:HTMLElement}>).detail; const form = (detail?.elt ?? event.target as HTMLElement | null)?.closest(".wb-job-actions form"); const result = form?.getAttribute("hx-target"); if(result) { const target = document.querySelector(result); if(target) target.textContent = message; } };
  document.body.addEventListener("htmx:sendError", event => showJobActionError(event, "The connection failed. Nothing was saved; please retry."));
  document.body.addEventListener("htmx:timeout", event => showJobActionError(event, "This request exceeded 30 seconds. The page stopped waiting; please retry."));
</script>
<style>
