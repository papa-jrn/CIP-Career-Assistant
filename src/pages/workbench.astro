---
import Layout from "../layouts/Layout.astro";
import { createServer } from "../lib/supabase/server";
import { parseAnalysisAdvisor, parseIntakeSource } from "../lib/cip/resume-asset-context";
import type { AdvisorAnalysis } from "../lib/cip/advisor";
import { loadWorkActions, type WorkAction } from "../lib/cip/workbench-actions";

const views = [{ key: "overview", label: "Overview" }, { key: "work", label: "My work" }, { key: "changes", label: "What changed" }];
const requested = Astro.url.searchParams.get("view");
const view = views.some(v => v.key === requested) ? requested : "overview";
let signedIn = false;
let hasIntake = false;
let advisor: Partial<AdvisorAnalysis> | null = null;
let analysisAt: string | null = null;
let actions: WorkAction[] = [];
let pending = 0;
let error = "";
if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const db = createServer(Astro.cookies);
    const { data: { user }, error: authError } = await db.auth.getUser();
    if (authError && authError.name !== "AuthSessionMissingError") throw new Error("Unable to check your sign-in. Please retry.");
    signedIn = Boolean(user);
    if (user) {
      const [intake, analysis, work] = await Promise.all([
        db.from("career_sources").select("extracted_text").eq("user_id", user.id).eq("source_type", "resume_intake").order("created_at", { ascending: false }).limit(1).maybeSingle(),
        db.from("career_sources").select("extracted_text,created_at").eq("user_id", user.id).eq("source_type", "evidence_analysis").order("created_at", { ascending: false }).limit(1).maybeSingle(),
        loadWorkActions(db, user.id),
      ]);
      if (intake.error || analysis.error) throw new Error("Your saved direction could not be loaded. Please retry.");
      hasIntake = Boolean(parseIntakeSource(intake.data?.extracted_text ?? null));
      advisor = parseAnalysisAdvisor(analysis.data?.extracted_text ?? null);
      analysisAt = analysis.data?.created_at ?? null;
      actions = work;
      let query = db.from("career_sources").select("id", { count: "exact", head: true }).eq("user_id", user.id)
        .in("source_type", ["resume_intake", "evidence_response", "source_analysis", "conversation_outcome"]);
      if (analysisAt) query = query.gt("created_at", analysisAt);
      const count = await query;
      if (count.error) throw new Error("Could not check pending updates. Please retry before updating strategy.");
      pending = count.count ?? 0;
    }
  } catch (e) { error = e instanceof Error ? e.message : "Could not load your workspace."; }
}
const visibleActions = actions.filter(a => a.status === "active");
const savedActions = actions.filter(a => a.status !== "active");
const changeLog = advisor?.changeLog;
const incomingContext = (Astro.url.searchParams.get("context") ?? "").slice(0, 300);
const incomingTitle = (Astro.url.searchParams.get("title") ?? "").slice(0, 180);
const existingHandoff = actions.find(a => a.title.trim().toLowerCase() === incomingTitle.trim().toLowerCase() && a.context.trim().toLowerCase() === incomingContext.trim().toLowerCase());
---
<Layout title="Workbench — CIP" description="Capture what you learn, work your priorities, and update your direction.">
  <main class="wb mx-auto w-full max-w-6xl px-5 py-8">
    <header class="wb-heading">
      <div><p class="wb-eyebrow">Your career workspace</p><h1>What will you work on next?</h1><p>Bring back what you learn. Choose where to put your effort.</p></div>
      {signedIn && !error && <a class="wb-button" href="#capture">Add an update</a>}
    </header>
    {error ? <section class="wb-card" role="alert"><h2>Your workspace could not be loaded</h2><p>{error}</p><a href="/workbench">Retry</a></section> : !signedIn ? (
      <section class="wb-card"><h2>Your work stays with you</h2><p>Sign in to capture updates, keep your actions, and review your direction.</p><a class="wb-button" href="/login">Sign in</a></section>
    ) : (
      <>
        <nav class="wb-tabs" aria-label="Workbench views">
          {views.map(v => <a href={`/workbench?view=${v.key}`} aria-current={view === v.key ? "page" : undefined}>{v.label}</a>)}
          <a href="/opportunities">Opportunities ↗</a>
        </nav>
        {!hasIntake && <section class="wb-card"><p class="wb-eyebrow">Start here</p><h2>Build a direction worth exploring</h2><p>First capture your story, then deepen the evidence and review your career lanes. You can return to these whenever your situation changes.</p><div class="wb-links"><a href="/intake">1. Tell your story</a><a href="/evidence">2. Dig deeper</a><a href="/assets">3. Review your lanes</a></div></section>}
        {hasIntake && <section class="wb-update">
          <div><strong>{pending} saved {pending === 1 ? "input" : "inputs"} since your last analysis</strong><p>Includes evidence, analyzed sources, conversations, and intake updates. Task status changes alone do not require analysis.</p></div>
          <form method="post" action="/api/evidence/analyze" hx-post="/api/evidence/analyze" hx-target="#strategy-result" hx-swap="innerHTML" hx-indicator="#strategy-progress" hx-disabled-elt="find button">
            <button class="wb-button" type="submit">Update my strategy</button>
          </form>
          <p id="strategy-progress" class="htmx-indicator" role="status">Updating from saved inputs. Your notes remain saved if this fails.</p>
          <div id="strategy-result" aria-live="polite"></div>
          <p class="wb-small">Uses the existing evidence analysis. It does not start a job search, read new URLs, or generate resumes. <a href="/evidence">Analyze linked sources</a> before updating if you added links.</p>
        </section>}
        {view === "overview" && <div class="wb-grid">
          <section class="wb-card"><p class="wb-eyebrow">Your current direction</p><h2>Your experience, connected</h2>
            {advisor?.summary ? <><p>{advisor.summary}</p><p class="wb-small">{advisor.mode === "ai" ? "AI-derived interpretation; review and correct it." : "Deterministic interpretation from saved inputs."} Last analysis: {analysisAt?.slice(0, 10) ?? "not available"}.</p></> : <p>Your intake is the starting point. Work through Evidence to build your first analysis.</p>}
            <div class="wb-links"><a href="/evidence">Deepen your evidence</a><a href="#capture">Correct your direction</a><a href="/assets">Career lanes</a></div>
            <details><summary>Saved positioning</summary><ul>{(advisor?.positioning ?? []).map(item => <li>{item}</li>)}</ul></details>
          </section>
          <section class="wb-card"><p class="wb-eyebrow">Your next moves</p><h2>{visibleActions.length} active actions</h2>
            {visibleActions.length ? <ul>{visibleActions.slice(0, 5).map(a => <li><a href={`/workbench?view=work#action-${a.actionId}`}>{a.title}</a>{a.context && <span> · {a.context}</span>}</li>)}</ul> : <p>Choose a specific investigation or experiment below. Existing follow-ups remain available in People while their integration is built.</p>}
            <div class="wb-links"><a href="/workbench?view=work">Work on an action</a><a href="/follow-up">Existing follow-ups</a></div>
          </section>
        </div>}
        {view === "work" && <section class="wb-card"><p class="wb-eyebrow">My work</p><h2>Work a priority, record what happened</h2>
          {existingHandoff && <p>This action is already saved ({existingHandoff.status}). <a href={`#action-${existingHandoff.actionId}`}>Open its history and outcome</a>.</p>}{!actions.length && <p>No actions saved here yet. Add a concrete next move below.</p>}
          {[...visibleActions, ...savedActions].map(a => <details class="wb-action" id={`action-${a.actionId}`}>
            <summary><strong>{a.title}</strong><span>{a.status}{a.context ? ` · ${a.context}` : ""}</span></summary>
            <form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target={`#result-${a.actionId}`} hx-swap="innerHTML" hx-disabled-elt="find button">
              <input type="hidden" name="operation" value="outcome" /><input type="hidden" name="actionId" value={a.actionId} />
              <label>What did you find? An unknown result is useful too.<textarea name="note" rows="4" maxlength="12000"></textarea></label>
              <label>Action status<select name="status">{["active", "deferred", "completed", "dismissed"].map(s => <option value={s} selected={a.status === s}>{s === "active" && a.status !== "active" ? "Reopen" : s}</option>)}</select></label>
              <button class="wb-button" type="submit">Save outcome</button><div id={`result-${a.actionId}`} aria-live="polite"></div>
            </form>
            <details><summary>History ({a.history.length})</summary>{a.history.map(h => <div class="wb-history"><p class="wb-small">{h.at.slice(0, 10)} · {h.status}</p><p>{h.note || "Status recorded; no findings added."}</p></div>)}</details>
          </details>)}
          <details class="wb-action" open={Boolean(incomingTitle && !existingHandoff)}><summary>Add a next move</summary><form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#create-result" hx-disabled-elt="find button">
            <input type="hidden" name="operation" value="create" />
            <label>Specific action<input name="title" required minlength="4" maxlength="180" value={incomingTitle} placeholder="Check this employer's funding" /></label>
            <label>Employer, person, or direction<input name="context" maxlength="300" value={incomingContext} /></label>
            <label>Type<select name="kind"><option value="research">Research</option><option value="funding">Funding check</option><option value="experiment">Career experiment</option></select></label>
            <button class="wb-button" type="submit">Add action</button><div id="create-result" aria-live="polite"></div>
          </form></details>
        </section>}
        {view === "changes" && <section class="wb-card"><p class="wb-eyebrow">What changed</p><h2>{changeLog?.hasChanges ? "Your latest strategy changes" : "Your latest analysis"}</h2>
          <p>{changeLog?.summary || "No change explanation is available yet. Add evidence and update your strategy to establish a baseline."}</p>
          {changeLog && [{ title: "Strengthened", items: changeLog.strengthened }, { title: "Weakened", items: changeLog.weakened }, { title: "Questions answered", items: changeLog.newlyAnswered }].map(group => group.items?.length > 0 && <section><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></section>)}
          <a href="/report">View existing strategy report</a>
        </section>}
        <section id="capture" class="wb-card"><p class="wb-eyebrow">Add an update</p><h2>What happened? What do you want to explore?</h2><p>Save research, a correction, or a change in direction. This adds to your history; it does not overwrite earlier evidence.</p>
          <form method="post" action="/api/workbench/save" hx-post="/api/workbench/save" hx-target="#capture-result" hx-disabled-elt="find button">
            <input type="hidden" name="operation" value="capture" />
            <label>What kind of update?<select name="kind"><option value="research">Research finding</option><option value="funding">Funding finding</option><option value="goal">Goal or interest change</option><option value="experiment">Experiment result</option><option value="evidence">Evidence or correction</option></select></label>
            <label>Related employer, person, or direction (optional)<input name="context" maxlength="300" value={incomingContext} /></label>
            <label>Your update<textarea name="note" required minlength="12" maxlength="12000" rows="5" placeholder="What did you learn, and what might it change?"></textarea></label>
            <p class="wb-small">Saved as information you provided, not independently verified proof. Goals are labeled as intentions. Conversation capture with structured people and follow-ups is still available in <a href="/network">Network</a>.</p>
            <button class="wb-button" type="submit">Save update</button><div id="capture-result" aria-live="polite"></div>
          </form>
        </section>
      </>
    )}
  </main>
</Layout>
<script>
  // htmx does not swap error responses by default. Keep actionable server errors visible.
  document.body.addEventListener("htmx:beforeSwap", (event) => {
    const detail = (event as CustomEvent<{ target?: HTMLElement; xhr?: XMLHttpRequest; shouldSwap: boolean; isError: boolean }>).detail;
    if (detail?.target?.closest(".wb") && detail.xhr && detail.xhr.status >= 400) {
      detail.shouldSwap = true;
      detail.isError = false;
    }
  });
  document.body.addEventListener("htmx:sendError", (event) => {
    const detail = (event as CustomEvent<{ target?: HTMLElement }>).detail;
    if (detail?.target?.closest(".wb")) detail.target.textContent = "The connection failed. Your form is still here; please retry.";
  });
</script>
<style>
.wb{--headline-font:Inter,system-ui,sans-serif;--body-font:Inter,system-ui,sans-serif;--accent:#3958d9;--accent-strong:#2543ad;--accent-soft:#edf1ff;--line:#dbe1ed;--muted:#526078;color:#17233c;font-family:Inter,system-ui,sans-serif;background:#f4f6fc;border-radius:18px;margin-top:20px;margin-bottom:24px}.wb-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.wb h1{font-family:Inter,system-ui,sans-serif;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;letter-spacing:-.04em}.wb h2{font-size:1.3rem;font-weight:650;margin-bottom:12px}.wb h3{font-weight:650;margin-top:16px}.wb p{line-height:1.7;margin:8px 0}.wb-eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.13em;color:#3958d9;font-weight:700}.wb-card,.wb-update{border:1px solid #dbe1ed;background:white;border-radius:14px;padding:24px;margin-bottom:20px;min-width:0}.wb-update{background:#edf1ff}.wb-button{display:inline-block;border:0;border-radius:8px;background:#3958d9;color:white;padding:10px 16px;font-weight:600;cursor:pointer}.wb a:not(.wb-button){color:#2543ad;text-decoration:underline;text-underline-offset:3px}.wb-tabs{display:flex;gap:8px;overflow-x:auto;margin-bottom:24px;padding-bottom:8px}.wb-tabs a{white-space:nowrap;padding:10px 14px;border-radius:8px;text-decoration:none!important}.wb-tabs a[aria-current]{background:#172b57;color:white}.wb-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:20px}.wb-small{font-size:.84rem;color:#526078}.wb-links{display:flex;gap:16px;flex-wrap:wrap;margin:16px 0}.wb label{display:grid;gap:6px;margin:14px 0;font-weight:550}.wb input,.wb textarea,.wb select{width:100%;border:1px solid #b8c3d8;border-radius:7px;padding:10px;background:#fff;color:#17233c;font-weight:400}.wb summary{cursor:pointer;padding:12px 0}.wb-action{border-top:1px solid #dbe1ed;padding:6px 0;scroll-margin-top:100px}.wb-action summary span{display:block;font-size:.82rem;color:#526078;margin-top:5px}.wb-history{border-left:3px solid #dbe1ed;padding-left:12px;white-space:pre-wrap}.wb ul{list-style:disc;padding-left:22px;line-height:1.8}.wb :focus-visible{outline:3px solid #637ff2;outline-offset:3px}.wb button:disabled{opacity:.55;cursor:wait}#strategy-result{overflow-wrap:anywhere}@media(max-width:700px){.wb-grid{grid-template-columns:1fr}.wb-heading{align-items:flex-start;flex-direction:column}.wb-card,.wb-update{padding:18px}.wb{border-radius:0;margin-top:0}}
</style>
