---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { briefingItems } from "../lib/cip/data";
import { formatRegion, getStaleSignalNotice, type StaleSignalNotice } from "../lib/cip/weekly-strategy";
import { createServer } from "../lib/supabase/server";

type Snapshot = {
  id: string;
  week_start: string;
  region_focus: string[];
  watched_employer_count: number;
  opportunity_match_count: number;
  summary: string;
  next_actions: string[];
  evidence: Array<Record<string, unknown>>;
  created_at: string;
};

type StrategicStateEvidence = {
  type: "strategic_state";
  conversation_outcome_count?: number;
  lane_scores?: Array<{
    lane: string;
    label: string;
    score: number;
    direction: "up" | "down" | "steady";
    reasons: string[];
  }>;
  employer_scores?: Array<{
    name: string;
    score: number;
    direction: "up" | "down" | "steady";
    reasons: string[];
    nextMove?: string;
    next_move?: string;
  }>;
  deltas?: string[];
};

let signedIn = false;
let snapshots: Snapshot[] = [];
let loadError = "";
let staleNotice: StaleSignalNotice | null = null;

if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const supabase = createServer(Astro.cookies);
    const {
      data: { user },
    } = await supabase.auth.getUser();
    signedIn = Boolean(user);

    if (user) {
      const [{ data, error }, notice] = await Promise.all([
        supabase
          .from("career_strategy_snapshots")
          .select("*")
          .eq("user_id", user.id)
          .order("week_start", { ascending: false })
          .limit(8),
        getStaleSignalNotice(supabase, user.id),
      ]);

      if (error) loadError = error.message;
      else snapshots = (data ?? []) as Snapshot[];
      staleNotice = notice;
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Unable to load briefings.";
  }
}

function strategicState(snapshot: Snapshot): StrategicStateEvidence | null {
  return (snapshot.evidence ?? []).find((item) => item?.type === "strategic_state") as StrategicStateEvidence | undefined ?? null;
}

function movementClass(direction: string) {
  if (direction === "up") return "text-[var(--accent-strong)]";
  if (direction === "down") return "text-[var(--warning)]";
  return "text-[var(--muted)]";
}
---

<Layout title="CIP Weekly Briefing">
  <main class="cip-page-shell mx-auto w-full max-w-5xl px-5 py-8">
    <section class="rounded-xl border border-[var(--line)] bg-[var(--panel)] p-6 shadow-[var(--shadow-card)] md:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-[var(--accent-strong)]">Weekly Career Intelligence</p>
          <h1 class="mt-2 text-3xl md:text-4xl" style="font-family: var(--headline-font); font-weight: 620; letter-spacing: -0.02em;">A recurring strategy memo, backed by employers and matches.</h1>
          <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--muted)] md:text-base">
            Use this to turn employer monitoring into a weekly path forward: what to research, what to adapt, and where to focus outreach.
          </p>
        </div>
        <div class="flex flex-col items-stretch gap-2 sm:items-end">
          <form hx-post="/api/briefing/generate" hx-target="#briefing-result" hx-swap="innerHTML" hx-indicator="#briefing-loading">
            <button class="cip-fancy-button" type="submit" disabled={!signedIn}>
              <span class="flex items-center gap-2">
                <Icon name="sparkles" class="h-4 w-4" strokeWidth={2} />
                Generate weekly snapshot
              </span>
            </button>
          </form>
          <a class="cip-fancy-button cip-fancy-button-secondary" href="/report">
            <span>View Career Report</span>
          </a>
        </div>
      </div>

      <div id="briefing-loading" class="htmx-indicator mt-5 rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
        <div class="flex items-center gap-3 text-sm font-semibold text-[var(--accent-strong)]">
          <span class="h-4 w-4 animate-spin rounded-full border-2 border-[var(--line)] border-t-[var(--accent)]"></span>
          Building weekly career strategy from watched employers and opportunity matches...
        </div>
      </div>
      <div id="briefing-result" class="mt-5"></div>

      {staleNotice && staleNotice.newConversationCount > 0 ? (
        <div class="mt-5 rounded-md border border-[var(--accent)] bg-[var(--accent-soft)] p-4">
          <p class="text-sm font-semibold text-[var(--accent-strong)]">
            {staleNotice.newConversationCount} conversation {staleNotice.newConversationCount === 1 ? "note was" : "notes were"} saved after your last analysis
            {staleNotice.lastAnalysisAt ? ` (last analysis ${staleNotice.lastAnalysisAt.slice(0, 10)})` : ""}
          </p>
          <p class="mt-1 text-sm leading-6 text-[var(--muted)]">
            Snapshots and the report reuse your last saved analysis, so they cannot reflect new conversations yet.
            <a class="font-semibold underline" href="/evidence">Re-analyze evidence</a> to process them, then generate the snapshot again.
          </p>
        </div>
      ) : null}

      {loadError ? (
        <p class="mt-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">{loadError}</p>
      ) : null}

      {snapshots.length ? (
        <div class="mt-6 grid gap-4">
          {snapshots.map((snapshot) => (
            <article class="rounded-md border border-[var(--line)] bg-[var(--background)] p-5">
              {(() => {
                const state = strategicState(snapshot);
                return state ? (
                  <div class="mb-5 rounded-md border border-[var(--accent)] bg-[var(--accent-soft)] p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="text-sm font-semibold text-[var(--accent-strong)]">What changed</h3>
                      <span class="rounded-md border border-[var(--line)] bg-[var(--panel)] px-2 py-1 text-xs font-semibold text-[var(--muted)]">
                        {state.conversation_outcome_count ?? 0} conversation signals
                      </span>
                    </div>
                    {state.deltas?.length ? (
                      <ul class="mt-3 space-y-2 text-sm leading-6 text-[var(--muted)]">
                        {state.deltas.slice(0, 5).map((delta) => <li>{delta}</li>)}
                      </ul>
                    ) : (
                      <p class="mt-3 text-sm leading-6 text-[var(--muted)]">No lane or employer ranking moved in this snapshot.</p>
                    )}
                    {state.lane_scores?.length ? (
                      <div class="mt-4 grid gap-3 md:grid-cols-3">
                        {state.lane_scores.slice(0, 3).map((lane) => (
                          <div class="rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
                            <p class="text-xs font-semibold uppercase text-[var(--muted)]">{lane.label}</p>
                            <p class="mt-1 text-sm font-semibold">{lane.lane}</p>
                            <p class={`mt-2 text-xs font-semibold ${movementClass(lane.direction)}`}>{lane.score} / {lane.direction}</p>
                          </div>
                        ))}
                      </div>
                    ) : null}
                    {state.employer_scores?.length ? (
                      <div class="mt-4">
                        <h4 class="text-xs font-semibold uppercase text-[var(--muted)]">Top propagated employers</h4>
                        <div class="mt-2 grid gap-2 md:grid-cols-2">
                          {state.employer_scores.slice(0, 4).map((employer) => (
                            <div class="rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
                              <div class="flex items-center justify-between gap-2">
                                <p class="text-sm font-semibold">{employer.name}</p>
                                <span class={`text-xs font-semibold ${movementClass(employer.direction)}`}>{employer.score} / {employer.direction}</span>
                              </div>
                              <p class="mt-1 text-xs leading-5 text-[var(--muted)]">{employer.nextMove ?? employer.next_move ?? employer.reasons?.[0]}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    ) : null}
                  </div>
                ) : null;
              })()}
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-xl font-semibold">Week of {snapshot.week_start}</h2>
                <span class="rounded-md bg-[var(--accent-tint)] px-2 py-1 text-xs font-semibold text-[var(--accent-strong)]">
                  {snapshot.watched_employer_count} employers / {snapshot.opportunity_match_count} matches
                </span>
              </div>
              <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{snapshot.summary}</p>
              {snapshot.region_focus?.length ? (
                <div class="mt-4 flex flex-wrap gap-2">
                  {snapshot.region_focus.map((region) => (
                    <span class="rounded-md border border-[var(--line)] bg-[var(--panel)] px-2 py-1 text-xs font-semibold text-[var(--muted)]">{formatRegion(region)}</span>
                  ))}
                </div>
              ) : null}
              <ol class="mt-5 space-y-3">
                {snapshot.next_actions.map((action, index) => (
                  <li class="flex gap-3 text-sm leading-6 text-[var(--muted)]">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-[var(--foreground)] text-xs font-semibold text-[var(--background)]">{index + 1}</span>
                    <span>{action}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-6 grid gap-4">
          {briefingItems.map((item) => (
            <article class="rounded-md border border-[var(--line)] bg-[var(--background)] p-5">
              <p class="text-sm leading-6 text-[var(--muted)]">{item}</p>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
