---
import Layout from "../layouts/Layout.astro";
import { loadLatestIntake } from "../lib/cip/profile";
import {
  intakeSuggestions,
  loadStoredSearchPreferences,
  type StoredSearchPreferences,
} from "../lib/cip/search-preferences";
import { createServer } from "../lib/supabase/server";

const supabase = createServer(Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();
if (!user) return Astro.redirect("/login");

const [intake, loaded] = await Promise.all([
  loadLatestIntake(supabase, user.id),
  loadStoredSearchPreferences(supabase, user.id).catch((err: Error) => err),
]);

const loadError = loaded instanceof Error ? loaded.message : "";
const stored: StoredSearchPreferences | null = loaded instanceof Error ? null : loaded;
const suggestions = intakeSuggestions(intake as Record<string, unknown> | null);
const usingSuggestions = Boolean(stored && !stored.hasAny);

const salaryValue = stored?.hasAny ? stored.salaryFloorUsd : suggestions.salaryFloorUsd;
const selectedModes = new Set<string>(stored?.hasAny ? stored.workModes : suggestions.workModes);
const lines = (items: string[] | undefined) => (items ?? []).join("\n");
const anchorLines = (stored?.anchorRequests ?? []).map((a) => `${a.label} | ${a.radiusMiles}`).join("\n");

const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
const freeText = [
  { label: "Salary, location, and work model (from Intake)", text: String(intake?.career_constraints ?? "").trim() },
  { label: "Industries: energizing and hard no's (from Intake)", text: String(intake?.industry_preferences ?? "").trim() },
].filter((item) => item.text);

const modeOptions = [
  { value: "onsite", label: "On-site" },
  { value: "hybrid", label: "Hybrid" },
  { value: "remote", label: "Remote" },
];
const fieldClass = "rounded-md border border-[var(--line)] bg-[var(--background)] p-3 text-sm";
const [addedCount, retiredCount] = (saved ?? "").split("-");
---

<Layout title="Search Preferences - Career Intelligence Platform">
  <main class="cip-page-shell min-h-screen">
    <div class="mx-auto w-full max-w-4xl px-5 py-8">
      <section class="cip-card rounded-lg p-6">
        <p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Search preferences</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Tell the search what is firm and what is not.</h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">
          These are the constraints the weekly search will actually use. Nothing here is guessed from your intake:
          a value counts only after you confirm it and save. Anything left blank is treated as unknown, not as "no limit."
          Hard exclusions stay in this app and are used to filter results; they are never sent to a search provider.
        </p>

        {saved && (
          <p class="mt-4 rounded-md border border-[var(--line)] bg-[var(--background)] p-3 text-sm font-semibold text-[var(--accent-strong)]" role="status">
            Saved. Added {addedCount}, retired {retiredCount}.
          </p>
        )}
        {error && (
          <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">Could not save: {error}</p>
        )}
        {loadError && (
          <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">Could not load saved preferences: {loadError}</p>
        )}
        {usingSuggestions && (suggestions.salaryFloorUsd || suggestions.workModes.length > 0) && (
          <p class="mt-4 rounded-md bg-yellow-50 p-3 text-sm text-yellow-900">
            Nothing is saved yet. Salary and work model below are <strong>suggestions from your intake</strong>. Your intake
            value may be a target rather than a minimum, so check it before saving.
          </p>
        )}

        {freeText.length > 0 && (
          <div class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--panel)] p-4">
            <h2 class="text-sm font-semibold">What you wrote in Intake (for reference)</h2>
            <div class="mt-3 grid gap-3">
              {freeText.map((item) => (
                <div>
                  <p class="text-xs font-semibold text-[var(--muted)]">{item.label}</p>
                  <p class="mt-1 whitespace-pre-wrap text-sm leading-6">{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <form class="mt-6 grid gap-5" method="post" action="/api/preferences/save">
          <label class="grid gap-2">
            <span class="text-sm font-semibold">Minimum annual salary (USD)</span>
            <input name="salary_floor" inputmode="numeric" class={fieldClass} placeholder="e.g. 85000" value={salaryValue ?? ""} />
            <span class="text-xs text-[var(--muted)]">A floor only. No upper limit is ever assumed. Leave blank if you have no firm minimum.</span>
          </label>

          <fieldset class="grid gap-2">
            <legend class="text-sm font-semibold">Work models you would accept</legend>
            <div class="flex flex-wrap gap-4">
              {modeOptions.map((mode) => (
                <label class="inline-flex items-center gap-2 text-sm">
                  <input class="h-4 w-4 accent-[var(--accent)]" type="checkbox" name="work_modes" value={mode.value} checked={selectedModes.has(mode.value)} />
                  {mode.label}
                </label>
              ))}
            </div>
          </fieldset>

          <label class="grid gap-2">
            <span class="text-sm font-semibold">Limits on remote work</span>
            <input name="remote_limits" class={fieldClass} maxlength="300" placeholder="e.g. Must be based in Vermont or New Hampshire" value={stored?.remoteLimits ?? ""} />
            <span class="text-xs text-[var(--muted)]">Optional. Residency or work-authorization limits you know apply to you.</span>
          </label>

          <label class="grid gap-2">
            <span class="text-sm font-semibold">Where you would work</span>
            <textarea name="anchors" rows="3" class={fieldClass} placeholder="White River Junction, VT | 25">{anchorLines}</textarea>
            <span class="text-xs text-[var(--muted)]">One place per line, optionally followed by | and a radius in miles (default 25, up to 5 places). The radius is straight-line distance, not driving time.</span>
          </label>

          <div class="grid gap-5 md:grid-cols-3">
            <label class="grid gap-2">
              <span class="text-sm font-semibold">Industries to exclude</span>
              <textarea name="exclusion_industries" rows="5" class={fieldClass}>{lines(stored?.exclusions.industries)}</textarea>
            </label>
            <label class="grid gap-2">
              <span class="text-sm font-semibold">Roles to exclude</span>
              <textarea name="exclusion_roles" rows="5" class={fieldClass}>{lines(stored?.exclusions.roles)}</textarea>
            </label>
            <label class="grid gap-2">
              <span class="text-sm font-semibold">Employers to exclude</span>
              <textarea name="exclusion_employers" rows="5" class={fieldClass}>{lines(stored?.exclusions.employers)}</textarea>
            </label>
          </div>
          <p class="-mt-2 text-xs text-[var(--muted)]">One per line. These apply everywhere. Removing a line and saving removes that exclusion; earlier versions are kept in history.</p>

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Save preferences</button>
            <a href="/briefing" class="text-sm text-[var(--muted)] underline">Back to briefing</a>
          </div>
        </form>
      </section>
    </div>
  </main>
</Layout>
