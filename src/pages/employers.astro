                  height="440"
                />
              ) : null}
              <div class="absolute left-1/2 top-1/2 h-60 w-60 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[var(--accent-strong)]/40 bg-[var(--accent-strong)]/5"></div>
              <div class="absolute left-1/2 top-1/2 h-44 w-44 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[var(--accent-strong)]/50 bg-[var(--accent-strong)]/5"></div>
              <div class="absolute left-1/2 top-1/2 h-28 w-28 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[var(--accent-strong)]/60 bg-[var(--accent-strong)]/5"></div>
              <div class="absolute left-1/2 top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--accent-strong)] ring-4 ring-[var(--accent-soft)]"></div>
              {primaryRegionPreset?.municipalities.slice(0, 6).map((town, index) => {
                // Distribute the nearby-place chips evenly around the outer ring.
                const total = Math.min(primaryRegionPreset.municipalities.length, 6);
                const angle = (index / total) * 2 * Math.PI - Math.PI / 2;
                const ringOffset = 41;
                const x = 50 + ringOffset * Math.cos(angle);
                const y = 50 + ringOffset * Math.sin(angle);
                return (
                  <span
                    class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full border border-[var(--line)] bg-[var(--panel)] px-2 py-0.5 text-[10px] font-semibold text-[var(--muted)] shadow-sm"
