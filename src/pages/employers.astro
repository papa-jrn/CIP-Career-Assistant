          <div id="candidate-promote-result" class="mt-4"></div>
        </form>

        <details class="mt-4 rounded-md border border-[var(--line)] bg-[var(--panel)] p-4">
          <summary class="cursor-pointer text-sm font-semibold text-[var(--accent-strong)]">
            Excluded ({excludedList.length})
          </summary>
          {excludedList.length ? (
            <ul class="mt-3 grid gap-2">
              {excludedList.map((entry) => (
                <li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-[var(--line)] bg-[var(--background)] px-3 py-2">
                  <div>
                    <p class="text-sm font-semibold text-[var(--foreground)]">{entry.name}</p>
                    <p class="text-xs text-[var(--muted)]">
                      You excluded this{entry.createdAt ? ` on ${new Date(entry.createdAt).toLocaleDateString()}` : ""}.
                      {entry.note ? ` ${entry.note}` : ""}
                    </p>
                  </div>
                  <form method="post" action="/api/employers/target-status">
                    <input type="hidden" name="employerName" value={entry.name} />
                    <input type="hidden" name="status" value="new" />
                    <input type="hidden" name="returnTo" value="/employers" />
                    <button class="cip-action" type="submit">Put back in the queue</button>
                  </form>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-[var(--muted)]">You have not excluded any organisations.</p>
          )}
        </details>
      </section>

      </details>
    </section>
  </div>
  </main>
  <style>
    .loading-phrases {
      display: inline-grid;
      min-width: min(100%, 24rem);
    }

    .loading-phrases span {
      animation: loading-phrase-cycle 10s infinite;
      grid-area: 1 / 1;
      opacity: 0;
    }

    .loading-phrases span:nth-child(2) {
      animation-delay: 2s;
    }

    .loading-phrases span:nth-child(3) {
      animation-delay: 4s;
    }

    .loading-phrases span:nth-child(4) {
      animation-delay: 6s;
    }

    .loading-phrases span:nth-child(5) {
      animation-delay: 8s;
    }

    @keyframes loading-phrase-cycle {
      0%, 100% {
        opacity: 0;
      }
      8%, 18% {
        opacity: 1;
      }
      26% {
        opacity: 0;
      }
    }
  </style>
  <script>
    // Reopen the employer after a save; the server cannot see a URL fragment.
    function revealEmployerDossier() {
      let id = "";
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (!id.startsWith("target-")) return;
      const card = document.getElementById(id);
      const dossier = card?.querySelector<HTMLDetailsElement>("[data-employer-dossier]");
      if (dossier) dossier.open = true;
    }
    revealEmployerDossier();
    window.addEventListener("hashchange", revealEmployerDossier);
    // Keep validation/storage failures beside the form, with the entered URL intact.
    document.addEventListener("htmx:beforeSwap", (event) => {
      const detail = (event as CustomEvent).detail;
      if (detail?.target?.matches("[data-careers-result]") && detail.xhr?.status >= 400) {
        detail.shouldSwap = true;
        detail.isError = false;
      }
    });
    // Status shortcuts reveal the existing form without a second modal or form.
    document.addEventListener("click", (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("[data-open-target-status]");
      if (!link) return;
      const formDetails = document.getElementById(link.hash.slice(1));
      if (!(formDetails instanceof HTMLDetailsElement)) return;
      const dossier = formDetails.closest<HTMLDetailsElement>("[data-employer-dossier]");
      if (!dossier) return;
      event.preventDefault();
      dossier.open = true;
      formDetails.open = true;
      formDetails.querySelector<HTMLSelectElement>('select[name="status"]')?.focus();
    });
    // "Not interested" from the queue. The row lives inside the promote form, so
    // this posts on its own rather than nesting a second form inside that one.
    document.addEventListener("click", async (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-not-interested]");
      if (!button) return;

      const result = document.getElementById("candidate-promote-result");
      const payload = new FormData();
      payload.set("employerName", button.getAttribute("data-employer-name") || "");
      payload.set("status", "not_interested");
      payload.set("returnTo", "/employers");
      const parent = button.getAttribute("data-parent-organization");
      if (parent) payload.set("parentOrganization", parent);

      button.disabled = true;
      button.setAttribute("aria-disabled", "true");
      if (result) result.innerHTML = '<p class="text-sm font-semibold text-[var(--accent-strong)]">Recording that you are not interested...</p>';

      try {
        const response = await fetch("/api/employers/target-status", {
          method: "POST",
          body: payload,
          credentials: "same-origin",
          redirect: "manual",
        });
        if (response.ok || response.type === "opaqueredirect" || response.status === 303) {
          window.location.reload();
          return;
        }
        if (result) result.innerHTML = await response.text();
      } catch {
        if (result) result.innerHTML = '<p class="text-sm text-red-700">Could not record that. Nothing was changed; try again.</p>';
      } finally {
        button.disabled = false;
        button.removeAttribute("aria-disabled");
      }
    });

    document.addEventListener("click", async (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-clear-candidates]");
      if (!button) return;

      const mode = button.getAttribute("data-clear-candidates") || "selected";
      const form = document.getElementById("candidate-queue-form");
      const result = document.getElementById("candidate-promote-result");
      if (!form || !result) return;

      const payload = new FormData();
      payload.set("mode", mode);

      if (mode === "selected") {
        const checked = form.querySelectorAll('input[name="candidate_ids"]:checked');
        if (!checked.length) {
          result.innerHTML = '<p class="text-sm text-red-700">Select at least one candidate to clear.</p>';
          return;
        }
        checked.forEach((input) => payload.append("candidate_ids", input.value));
      }

      button.setAttribute("aria-disabled", "true");
      button.disabled = true;
      result.innerHTML = '<p class="text-sm font-semibold text-[var(--accent-strong)]">Updating candidate queue...</p>';

      try {
        const response = await fetch("/api/employers/candidates/clear", {
          method: "POST",
          body: payload,
          credentials: "same-origin",
        });
        const html = await response.text();
        result.innerHTML = html;
        if (response.ok) {
          window.setTimeout(() => window.location.reload(), 250);
        }
      } catch {
        result.innerHTML = '<p class="text-sm text-red-700">Unable to clear candidates. Try again.</p>';
      } finally {
        button.disabled = false;
        button.removeAttribute("aria-disabled");
      }
    });
  </script>
</Layout>
