        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-[0.95fr_1.05fr]">
          {signedIn && primaryRegionLabel ? (
            <div class="relative min-h-72 overflow-hidden rounded-md border border-[var(--line)] bg-[linear-gradient(135deg,var(--accent-tint),transparent_55%),var(--panel)] p-5">
              {staticMapUrl ? (
                <img
