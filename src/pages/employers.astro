---
import Layout from "../layouts/Layout.astro";
import { canRunLiveBusinessSearch } from "../lib/cip/business-search-engine";
import { geocodeCoordinates } from "../lib/cip/geography-engine";
import { loadFundingProfiles, planFinancialsLookup, type FundingProfile } from "../lib/cip/employer-financials";
import { renderBulkFinancialsControl, renderFinancialsBlock } from "../lib/cip/employer-financials-view";
import { normOrg } from "../lib/cip/employer-resolution";
import { escapeHtml } from "../lib/cip/job-search-view";
import type { TargetDossier } from "../lib/cip/target-dossier";
import { loadTargetWorkspace, type TargetWorkspace } from "../lib/cip/target-workspace-loader";
import { renderWorkspace } from "../lib/cip/target-workspace-view";
import { loadStrategicState, type StrategicEmployerScore } from "../lib/cip/strategic-state";
import { createServer } from "../lib/supabase/server";
import {
  currentTargetEvents,
  excludedKeys,
  excludedTargets,
  loadTargetEvents,
  partitionExcluded,
  resolveTargetStatus,
  TARGET_STATUSES,
  type TargetEvent,
} from "../lib/cip/employer-target-events";
import { STATUS_LABEL } from "../lib/cip/target-dossier";
import {
  currentCareersUrls,
  describeCareersUrl,
  loadCareersUrlCorrections,
  resolveCareersUrl,
  type CareersUrlCorrection,
} from "../lib/cip/employer-careers-url";

type EmployerRow = {
  id: string;
  name: string;
  region: string;
  category: string;
  location: string | null;
  estimated_size: string | null;
  priority: string;
  fit_score: number;
  fit_summary: string;
  target_roles: string[];
  source_url: string | null;
  careers_url: string | null;
  adapter_status: string;
  confidence: string;
  source_notes: Array<{ label: string; value: string; url: string }>;
  last_reviewed_at: string | null;
  /** The user's IRS 990 setting: auto (guess), on, or off. Absent until its migration is applied (reads as auto). */
  financials_mode?: string | null;
};

type CandidateRow = EmployerRow & {
  discovery_channel: string;
  discovery_source_names: string[];
  relevant_lanes?: string[];
  parent_organization?: string | null;
  review_state: string;
};

type SourceRow = {
  id: string;
  name: string;
  region: string;
  source_type: string;
  url: string;
  access_type: string;
  usefulness_score: number;
  notes: string;
};

const regionFocus = {
  new_york: {
    label: "New York City",
    center: "New York, NY",
    radius: "50 miles",
    latitude: 40.7128,
    longitude: -74.006,
    municipalities: ["Manhattan", "Brooklyn", "Queens", "Jersey City", "Newark", "Yonkers"],
  },
  boston: {
    label: "Boston",
    center: "Boston, MA",
    radius: "50 miles",
    latitude: 42.3601,
    longitude: -71.0589,
    municipalities: ["Boston", "Cambridge", "Somerville", "Newton", "Quincy", "Waltham"],
  },
  san_francisco: {
    label: "San Francisco Bay",
    center: "San Francisco, CA",
    radius: "50 miles",
    latitude: 37.7749,
    longitude: -122.4194,
    municipalities: ["San Francisco", "Oakland", "San Jose", "Berkeley", "Palo Alto", "Sunnyvale"],
  },
  toronto: {
    label: "Toronto",
    center: "Toronto, ON, Canada",
    radius: "50 miles",
    latitude: 43.6532,
    longitude: -79.3832,
    municipalities: ["Toronto", "Mississauga", "Brampton", "Markham", "Oakville", "Scarborough"],
  },
} as const;

// Employer sectors based on the U.S. BLS "Employment by major industry sector"
// table (total wage and salary employment, NAICS sectors). These are generic
// national-sector categories every user can pick from, replacing an earlier
// founder-specific list. Source: bls.gov/emp/tables/employment-by-major-industry-sector.htm
// `value` is what flows to the search engine; `label` is what the user sees.
const employerSectors = [
  { label: "Healthcare & social assistance", value: "healthcare and social assistance" },
  { label: "Retail trade", value: "retail trade" },
  { label: "Professional & business services", value: "professional and business services" },
  { label: "Government (federal, state, local)", value: "government" },
  { label: "Manufacturing", value: "manufacturing" },
  { label: "Education", value: "education" },
  { label: "Accommodation & food service", value: "accommodation and food service" },
  { label: "Construction", value: "construction" },
  { label: "Finance & insurance", value: "finance and insurance" },
  { label: "Transportation & warehousing", value: "transportation and warehousing" },
  { label: "Wholesale trade", value: "wholesale trade" },
  { label: "Information (tech, media, telecom)", value: "information" },
  { label: "Other services", value: "other services" },
  { label: "Arts, entertainment & recreation", value: "arts entertainment and recreation" },
  { label: "Real estate, rental & leasing", value: "real estate rental and leasing" },
  { label: "Mining, quarrying & oil/gas extraction", value: "mining quarrying and oil and gas extraction" },
  { label: "Agriculture, forestry, fishing & hunting", value: "agriculture forestry fishing and hunting" },
  { label: "Utilities", value: "utilities" },
];

let signedIn = false;
let employers: EmployerRow[] = [];
// The user's own answers about where each employer posts its jobs.
let careersUrlRecords: CareersUrlCorrection[] = [];
// The user's own decisions about each employer, including who they have
// excluded. Append-only, so a decision can be reversed without being erased.
let targetEventRecords: TargetEvent[] = [];
let candidates: CandidateRow[] = [];
let sources: SourceRow[] = [];
let loadError = "";
let candidateScoresByName = new Map<string, StrategicEmployerScore>();
// IRS Form 990 profiles for tracked employers (empty, never an error page, when the table is missing).
let fundingProfiles = new Map<string, FundingProfile>();
let fundingError: string | null = null;
// The target workspace (Rethink section 14): one dossier per tracked employer, built from data the app already holds.
let workspace: TargetWorkspace | null = null;
let workspaceError = "";

if (import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY) {
  try {
    const supabase = createServer(Astro.cookies);
    const {
      data: { user },
    } = await supabase.auth.getUser();
    signedIn = Boolean(user);

    if (user) {
      const { data, error } = await supabase
        .from("watched_employers")
        .select("*")
        .eq("user_id", user.id)
        .order("fit_score", { ascending: false });

      if (error) loadError = error.message;
      else employers = (data ?? []) as EmployerRow[];

      careersUrlRecords = await loadCareersUrlCorrections(supabase, user.id);
      targetEventRecords = await loadTargetEvents(supabase, user.id);

      const { data: candidateData } = await supabase
        .from("employer_candidates")
        .select("*")
        .eq("user_id", user.id)
        .order("fit_score", { ascending: false });
      candidates = (candidateData ?? []) as CandidateRow[];

      const { data: sourceData } = await supabase
        .from("discovery_sources")
        .select("*")
        .eq("user_id", user.id)
        .order("usefulness_score", { ascending: false });
      sources = (sourceData ?? []) as SourceRow[];

      const strategicState = await loadStrategicState(supabase, user.id);
      candidateScoresByName = new Map(
        strategicState.employerCandidates.map((candidate) => [
          normalizeEmployerName(candidate.name),
          candidate,
        ]),
      );

      const funding = await loadFundingProfiles(supabase, user.id);
      fundingProfiles = funding.profiles;
      fundingError = funding.error;

      try {
        workspace = await loadTargetWorkspace(supabase, user.id);
      } catch (workspaceFailure) {
        workspaceError = workspaceFailure instanceof Error ? workspaceFailure.message : "Could not build the target workspace.";
      }
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Unable to load watched employers.";
  }
}

// Whether an IRS 990 lookup applies to a tracked employer (the user's setting, else a guess from its name and category).
function financialsPlan(employer: EmployerRow) {
  return planFinancialsLookup({
    mode: employer.financials_mode,
    name: employer.name,
    category: employer.category,
    profile: fundingProfiles.get(normOrg(employer.name)) ?? null,
  });
}

function safeLink(url: string | null | undefined): string | null {
  if (!url) return null;
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" || parsed.protocol === "http:" ? parsed.href : null;
  } catch {
    return null;
  }
}

// Detail the dossier does not carry (kept from the old saved-businesses list so nothing is lost).
const targetEvents = currentTargetEvents(targetEventRecords);
const employerById = new Map(employers.map((employer) => [employer.id, employer]));
// What the user has told us about where each employer posts its jobs. The
// weekly search targets this, so a guess and an answer must not look alike.
const careersCorrections = currentCareersUrls(careersUrlRecords);
function extrasHtml(dossier: TargetDossier): string {
  const employer = employerById.get(dossier.employerId);
  if (!employer) return "";
  const chip = "rounded-md border border-[var(--line)] bg-[var(--panel)] px-2 py-1 text-xs font-semibold";
  const roles = (employer.target_roles ?? []).map((role) => `<span class="${chip}">${escapeHtml(role)}</span>`).join(" ");
  const notes = (employer.source_notes ?? []).map((note) => `<p><span class="font-semibold">${escapeHtml(note.label)}:</span> ${escapeHtml(note.value)}</p>`).join("");
  const sourceHref = safeLink(employer.source_url);
  const careers = resolveCareersUrl({ name: employer.name, careers_url: employer.careers_url }, careersCorrections);
  const careersHref = careers ? safeLink(careers.url) : null;
  const careersAnswer = careersCorrections.get(normOrg(employer.name));
  const noCareersPage = Boolean(careersAnswer && !careersAnswer.careersUrl);
  const links = [
    sourceHref ? `<a class="underline" href="${escapeHtml(sourceHref)}" target="_blank" rel="noopener noreferrer">Source</a>` : "",
    careersHref ? `<a class="underline" href="${escapeHtml(careersHref)}" target="_blank" rel="noopener noreferrer">Careers page</a>` : "",
  ].filter(Boolean).join(" · ");

  // What the user has decided about this employer, and a way to change it.
  const shownStatus = resolveTargetStatus(employer.name, dossier.status, targetEvents);
  const statusBlock = `
    <div class="mt-3 rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
      <p class="text-xs font-semibold uppercase text-[var(--muted)]">Your status for this employer</p>
      <p class="mt-1 text-sm font-semibold text-[var(--foreground)]">${escapeHtml(STATUS_LABEL[shownStatus.status] ?? shownStatus.status)}</p>
      <p class="mt-1 text-xs leading-5 text-[var(--muted)]">${
        shownStatus.source === "set"
          ? "You set this." + (shownStatus.note ? " " + escapeHtml(shownStatus.note) : "")
          : "CIP's suggestion from what it can see. Set your own below and yours will be used instead."
      }</p>
      <details class="mt-2" id="target-status-${escapeHtml(dossier.employerId)}">
        <summary class="cursor-pointer text-xs font-semibold text-[var(--accent-strong)]">Set your status</summary>
        <form class="mt-2 grid gap-2" method="post" action="/api/employers/target-status" hx-post="/api/employers/target-status">
          <input type="hidden" name="employerName" value="${escapeHtml(employer.name)}" />
          <input type="hidden" name="returnTo" value="/employers" />
          <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
            Status
            <select name="status" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]">
              ${TARGET_STATUSES.map((value) => `<option value="${value}"${value === shownStatus.status ? " selected" : ""}>${escapeHtml(STATUS_LABEL[value] ?? value)}</option>`).join("")}
            </select>
          </label>
          <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
            Why (optional)
            <input name="note" maxlength="300" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
          </label>
          <button class="cip-action justify-self-start" type="submit">Save my status</button>
          <p class="text-xs leading-5 text-[var(--muted)]">"Not interested" also stops discovery suggesting this organisation. It does not change your job-search exclusions, and you can undo it from the Excluded list.</p>
        </form>
      </details>
    </div>`;

  // Where the search will look, said plainly, with a way to correct it.
  const careersBlock = `
    <div class="mt-3 rounded-md border border-[var(--line)] bg-[var(--panel)] p-3">
      <p class="text-xs font-semibold uppercase text-[var(--muted)]">Where the search looks first</p>
      <p class="mt-1 text-xs leading-5 text-[var(--muted)]">${escapeHtml(describeCareersUrl(careers, noCareersPage))}</p>
      ${careers?.replaced ? `<p class="mt-1 text-xs leading-5 text-[var(--muted)]">It replaced: ${escapeHtml(careers.replaced)}</p>` : ""}
      <details class="mt-2">
        <summary class="cursor-pointer text-xs font-semibold text-[var(--accent-strong)]">${careers ? "Correct this address" : "Add the careers page"}</summary>
        <form class="mt-2 grid gap-2" method="post" action="/api/employers/careers-url" hx-post="/api/employers/careers-url" hx-target="#careers-result-${escapeHtml(dossier.employerId)}" hx-swap="innerHTML" hx-disabled-elt="find button">
          <input type="hidden" name="employerName" value="${escapeHtml(employer.name)}" />
          <input type="hidden" name="returnTo" value="/employers#target-${escapeHtml(dossier.employerId)}" />
          <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
            Careers page address
            <input name="careersUrl" type="url" maxlength="2000" placeholder="https://" value="${escapeHtml(careers?.url ?? "")}" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
          </label>
          <label class="inline-flex items-center gap-2 text-xs text-[var(--muted)]">
            <input type="checkbox" name="none" value="yes"${noCareersPage ? " checked" : ""} class="h-4 w-4" />
            This employer has no careers page I know of
          </label>
          <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
            How you found it (optional)
            <input name="note" maxlength="300" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]" />
          </label>
          <button class="cip-action justify-self-start" type="submit">Save this address</button>
          <div id="careers-result-${escapeHtml(dossier.employerId)}" data-careers-result role="status" aria-live="polite"></div>
          <p class="text-xs leading-5 text-[var(--muted)]">Used as a starting point in your next search. Saving an address does not confirm the page or verify any jobs.</p>
        </form>
      </details>
    </div>`;
  const body = [
    employer.location || employer.estimated_size ? `<p class="text-sm text-[var(--muted)]">${escapeHtml([employer.location, employer.estimated_size].filter(Boolean).join(" - "))}</p>` : "",
    employer.fit_summary ? `<p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(employer.fit_summary)}</p>` : "",
    roles ? `<p class="mt-2 flex flex-wrap gap-2">${roles}</p>` : "",
    notes ? `<div class="mt-2 space-y-1 text-xs text-[var(--muted)]">${notes}</div>` : "",
    links ? `<p class="mt-2 text-xs">${links}</p>` : "",
    statusBlock,
    careersBlock,
  ].join("");
  return body ? `<div class="mt-4"><h4 class="text-xs font-semibold uppercase text-[var(--muted)]">Details</h4>${body}</div>` : "";
}

const workspaceHtml = workspace
  ? renderWorkspace(workspace.dossiers.map((dossier) => {
      const status = resolveTargetStatus(dossier.name, dossier.status, targetEvents);
      return { ...dossier, status: status.status, statusSource: status.source };
    }), {
      run: workspace.run,
      renderExtras: extrasHtml,
      renderFunding: (dossier) => {
        const employer = employerById.get(dossier.employerId);
        return renderFinancialsBlock({
          employerId: dossier.employerId,
          employerName: dossier.name,
          profile: fundingProfiles.get(normOrg(dossier.name)) ?? null,
          plan: employer ? financialsPlan(employer) : undefined,
          setupError: fundingError,
        });
      },
    })
  : "";

const savedRegionKeys = [...new Set([...sources.map((source) => source.region), ...candidates.map((candidate) => candidate.region)])];
const focusRegions = savedRegionKeys;

// Primary search area for the signed-in "Search Radius Model" graphic (Option C:
// no API call). Prefer the first saved region that resolves to a preset (so we
// can show center + radius + nearby places); otherwise fall back to the first
// saved region as a plain label. null when the user has no saved regions yet.
const primaryRegionKey = savedRegionKeys.find((region) => Boolean(regionFocus[region as keyof typeof regionFocus])) ?? savedRegionKeys[0] ?? null;
const primaryRegionPreset = primaryRegionKey ? regionFocus[primaryRegionKey as keyof typeof regionFocus] ?? null : null;
const primaryRegionLabel = primaryRegionPreset?.label ?? (primaryRegionKey ? primaryRegionKey.replaceAll("_", " ") : null);

// Static map image (Geoapify) for the signed-in search-radius graphic. The key
// is exposed client-side by design — Geoapify static maps are designed to be
// embedded via <img> tags, and the key should be restricted by HTTP referrer in
// the Geoapify dashboard. Browser-caches the image per region, so cost is ~1
// fetch per region per user. Gated behind the env var so nothing breaks in dev
// without a key; the stylized graphic below is the fallback.
const geoapifyKey = import.meta.env.PUBLIC_GEOAPIFY_API_KEY || import.meta.env.GEOAPIFY_API_KEY || "";

// Resolve map coordinates for the primary region. Preset regions carry their
// own lat/long (zero cost). For any other saved region we do ONE lightweight
// Geocodio geocode (no Overpass) at render time to get coordinates, then the
// browser caches the resulting map image. Returns null when neither a preset
// nor geocoding resolves coordinates, in which case we fall back to rings-only.
let mapCoordinates: { latitude: number; longitude: number } | null = null;
if (geoapifyKey && primaryRegionLabel) {
  if (primaryRegionPreset?.latitude != null && primaryRegionPreset?.longitude != null) {
    mapCoordinates = { latitude: primaryRegionPreset.latitude, longitude: primaryRegionPreset.longitude };
  } else if (primaryRegionKey) {
    // Non-preset saved region — look it up. primaryRegionKey is the raw saved
    // region string (e.g. "lyndon vt"); geocode it to coordinates.
    const query = primaryRegionKey.replaceAll("_", " ");
    const geocoded = await geocodeCoordinates(query);
    if (geocoded) mapCoordinates = { latitude: geocoded.latitude, longitude: geocoded.longitude };
  }
}
const staticMapUrl = mapCoordinates
  ? `https://maps.geoapify.com/v1/staticmap?style=osm-bright&width=640&height=440&center=lonlat:${mapCoordinates.longitude},${mapCoordinates.latitude}&zoom=9&marker=lonlat:${mapCoordinates.longitude},${mapCoordinates.latitude};color:%231f4f38;size:medium&apiKey=${geoapifyKey}`
  : null;
const liveBusinessSearchEnabled = canRunLiveBusinessSearch();
const geocodioEnabled = Boolean(import.meta.env.GEOCODIO_API_KEY);
const savedEmployerNames = new Set(employers.map((employer) => normalizeEmployerName(employer.name)));

const excluded = excludedKeys(targetEvents);
const excludedList = excludedTargets(targetEvents);

const candidatesBeforeExclusion = candidates.filter((candidate) => {
  const alreadySaved = savedEmployerNames.has(normalizeEmployerName(candidate.name));
  return candidate.review_state !== "promoted" && !alreadySaved;
});
// Organisations the user said they are not interested in are suppressed, never
// silently: the count below says how many, and the Excluded list restores them.
const candidateSplit = partitionExcluded(candidatesBeforeExclusion, excluded);
const visibleCandidates = candidateSplit.kept;
const suppressedCount = candidateSplit.excluded.length;

function normalizeEmployerName(name: string) {
  return name.trim().toLowerCase().replace(/\s+/g, " ");
}
---

<Layout title="CIP Watched Employers">
  <main class="cip-page-shell min-h-screen">
  <div class="mx-auto w-full max-w-6xl px-5 py-8">
    <section class="cip-card rounded-lg p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase text-[var(--accent-strong)]">Target employers</p>
          <h1 class="mt-2 max-w-4xl text-4xl font-semibold tracking-tight">Who to talk to, what is open, and what to do next.</h1>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">
            Each target shows why it fits your lanes, who you know there, what is verified open, how it is funded, and the next move. These are the app's suggestions from what it knows; nothing is guessed. Search for new employers further down.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <p class={`inline-flex rounded-md px-2 py-1 text-xs font-semibold ${liveBusinessSearchEnabled ? "cip-pill" : "bg-yellow-50 text-yellow-800"}`}>
              {liveBusinessSearchEnabled ? "Live AI web search enabled" : "Live business search not configured: add OPENAI_API_KEY"}
            </p>
            <p class={`inline-flex rounded-md px-2 py-1 text-xs font-semibold ${geocodioEnabled ? "cip-pill" : "bg-[var(--background)] text-[var(--muted)]"}`}>
              {geocodioEnabled ? "GeoCodio primary geocoder active" : "GeoCodio not configured; fallback geocoder will be used"}
            </p>
          </div>
        </div>
      </div>

      {Astro.url.searchParams.get("careers") === "saved" && (
        <p class="mt-4 rounded-md border border-[var(--line)] bg-[var(--accent-soft)] p-3 text-sm text-[var(--accent-strong)]" data-announce tabindex="-1" role="status">Careers-page choice saved. Your next search will use this choice; existing search results have not been rechecked.</p>
      )}
      {signedIn ? (
        <div class="mt-6">
          {workspaceError ? <p class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">Could not build your target workspace: {workspaceError}</p> : null}
          {employers.length ? (
            <div class="mb-4">
              <Fragment
                set:html={renderBulkFinancialsControl({
                  total: employers.length,
                  withFilings: employers.filter((employer) => fundingProfiles.get(normOrg(employer.name))?.status === "ok").length,
                  skipped: employers.filter((employer) => !financialsPlan(employer).lookup).length,
                  setupError: fundingError,
                })}
              />
            </div>
          ) : null}
          <Fragment set:html={workspaceHtml} />
        </div>
      ) : (
        <p class="mt-6 rounded-md border border-[var(--line)] bg-[var(--background)] p-4 text-sm"><a class="font-semibold underline" href="/login">Sign in</a> to see your target employers.</p>
      )}

      <details id="discovery-tools" class="mt-8 rounded-lg border border-[var(--line)] p-4" open={!employers.length}>
        <summary class="cursor-pointer text-lg font-semibold">
          Find and review employers
          <span class="ml-2 text-sm font-normal text-[var(--muted)]">search a place, add small nonprofits from IRS 990 filings, review the queue{visibleCandidates.length ? ` (${visibleCandidates.length} waiting)` : ""}</span>
        </summary>
      <form class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5 shadow-sm" hx-post="/api/employers/discover" hx-target="#employer-discovery-result" hx-swap="innerHTML" hx-indicator="#employer-discovery-loading">
        <div>
          <h2 class="text-lg font-semibold">Find businesses by geography</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
            Runs a live web-backed employer discovery pass. It should find chambers, economic development groups, municipalities, school systems, business directories, and employer-owned career pages for the geography you enter.
          </p>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_1.2fr_0.8fr]">
          <label class="grid gap-2 rounded-md border border-[var(--line)] bg-[var(--background)] p-4">
            <span class="text-sm font-semibold">Geography</span>
            <input name="custom_geography" class="rounded-md border border-[var(--field-border)] bg-[var(--background)] p-3 text-sm" placeholder="New York, NY; Boston, MA; San Francisco, CA; Toronto, ON..." />
            <span class="text-xs text-[var(--muted)]">Start here. The search uses the exact place you enter; fixture/preset employers are not returned as normal search results.</span>
            {signedIn && (sources.length > 0 || candidates.length > 0) ? (
            <details class="mt-3">
              <summary class="cursor-pointer text-sm font-semibold text-[var(--muted)]">Reuse saved search areas</summary>
              <div class="mt-3 grid gap-2 text-sm">
                {savedRegionKeys.map((region) => (
                  <label class="inline-flex items-center gap-2">
