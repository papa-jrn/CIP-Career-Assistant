---
// Lets the user say who a saved conversation was actually with. Extraction is
// not reliable at naming people, and an unnamed conversation reaches nobody's
// follow-up card until someone can correct it.
interface Props {
  targetId: string;
  contactName: string;
  contactOrganization?: string;
  unknown: boolean;
  returnTo?: string;
  open?: boolean;
}

const { targetId, contactName, contactOrganization = "", unknown, returnTo = "/network", open = unknown } = Astro.props;
---

<details class="mt-3" open={open}>
  <summary class="cursor-pointer text-xs font-semibold text-[var(--accent-strong)]">
    {unknown ? "Say who this was with" : "Correct the contact"}
  </summary>
  <form class="mt-2 grid gap-2" method="post" action="/api/network/contact-correction" hx-post="/api/network/contact-correction">
    <input type="hidden" name="targetId" value={targetId} />
    <input type="hidden" name="returnTo" value={returnTo} />
    <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
      Who you spoke to
      <input
        name="contactName"
        required
        maxlength="80"
        value={unknown ? "" : contactName}
        placeholder="Full name"
        class="rounded-md border border-[var(--line)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]"
      />
    </label>
    <label class="grid gap-1 text-xs font-semibold text-[var(--muted)]">
      Organization (optional)
      <input
        name="contactOrganization"
        maxlength="120"
        value={contactOrganization}
        class="rounded-md border border-[var(--line)] bg-[var(--background)] p-2 text-sm font-normal text-[var(--foreground)]"
      />
    </label>
    <button type="submit" class="justify-self-start rounded-md bg-[var(--accent-strong)] px-3 py-2 text-xs font-semibold text-white">
      Save contact
    </button>
    <p class="text-xs leading-5 text-[var(--muted)]">
      Your correction is saved alongside the notes; the original reading is kept, not overwritten.
    </p>
  </form>
</details>
